---
// High School. Copy: src/content/high-school.ts. Design: design-handoff/reference/HighSchool.html,
// restructured by design-handoff/CHANGES.md section 3: FRC Team 3616 leads, then projects,
// leadership and community, service, and an awards teaser. Award mentions link to /awards.
import Layout from '../layouts/Layout.astro';
import PosterHero from '../components/PosterHero.astro';
import HighSchoolArt from '../components/art/HighSchoolArt.astro';
import SectionHead from '../components/SectionHead.astro';
import Surface from '../components/Surface.astro';
import Chip from '../components/Chip.astro';
import ImageSlot from '../components/ImageSlot.astro';
import AwardLink from '../components/AwardLink.astro';
import { meta, hero, frc, projects, community, service, awardsTeaser } from '../content/high-school';
import { emWidth } from '../lib/fit';

const deanFit = await emWidth(frc.deansList.heading);
const dl = frc.deansList;
---

<Layout meta={meta}>
  <PosterHero hero={hero} headlineSize={245} artGap={24} footGap={40} padBottom={70} halo={{ y: 230, w: 1100, h: 700, alpha: 0.45 }}>
    <HighSchoolArt slot="art" />
  </PosterHero>

  <!-- ---------- FRC Team 3616 ---------- -->
  <section class="section wrap" id={frc.id} aria-labelledby="frc-h">
    <SectionHead label={frc.label} heading={frc.heading} id="frc-h" drift="left" />
    <p class="hs-lead hs-lead--first" data-reveal>{frc.intro}</p>

    <p class="mono faint hs-kicker">{frc.roles.label}</p>
    <ol role="list" class="hstl" data-reveal>
      {
        frc.roles.milestones.map((m) => (
          <li class:list={['hstl__item', { 'hstl__item--hi': m.award }]}>
            <span class="hstl__dot" aria-hidden="true" />
            <p class:list={['mono hstl__date', m.award ? 'rim-ink' : 'faint']}>{m.date}</p>
            <h3 class="hstl__title cond">{m.award ? <AwardLink id={m.award}>{m.title}</AwardLink> : m.title}</h3>
            <p class="hstl__text muted">{m.text}</p>
          </li>
        ))
      }
    </ol>

    <p class="mono faint hs-kicker">{frc.seasons.label}</p>
    <ol role="list" class="hs-seasons">
      {
        frc.seasons.items.map((s) => (
          <li data-reveal>
            <Surface as="article" class="hs-season">
              <p class="huge outline hs-season__year" aria-hidden="true">
                {s.year}
              </p>
              <p class="mono rim-ink">
                {s.year} · {s.lang}
              </p>
              <p class="hs-season__text">{s.text}</p>
            </Surface>
          </li>
        ))
      }
    </ol>
    <p class="hs-note muted" data-reveal>{frc.seasons.note}</p>

    <div class="hs-block">
      <SectionHead label={frc.leadership.label} heading={frc.leadership.heading} level={3} size="mid" drift="right" />
      <ol role="list" class="hs-subs" data-reveal>
        {
          frc.leadership.subteams.map((name, i) => (
            <li>
              <Surface class="hs-sub">
                <span class="mono faint">{String(i + 1).padStart(2, '0')}</span>
                <span class="hs-sub__name cond">{name}</span>
              </Surface>
            </li>
          ))
        }
      </ol>
      <p class="hs-lead" data-reveal>{frc.leadership.text}</p>
      <div class="hs-chips" data-reveal>
        {frc.leadership.roles.map((r) => <Chip label={r} />)}
      </div>
    </div>

    <div class="hs-cards" data-reveal>
      <div class="hs-dean">
        <p class="mono rim-ink">{dl.label}</p>
        <div class="hs-dean__fit">
          <p class="hs-dean__h huge litx" style={`--fit:${deanFit}`}>{dl.heading}</p>
        </div>
        <p class="hs-dean__text">{dl.text}</p>
        <a href={dl.link.href} class="hs-dean__link cap">
          {dl.link.label}
          <svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
      <Surface class="hs-pod">
        <div>
          <p class="mono faint">{dl.podcast.label}</p>
          <h3 class="hs-pod__title cond">{dl.podcast.title}</h3>
          <p class="hs-pod__text muted">{dl.podcast.text}</p>
        </div>
        <a href={dl.podcast.link.href} rel="noopener" class="hs-pod__link">
          <span class="hs-pod__play" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z" />
            </svg>
          </span>
          <span class="hs-pod__wave" aria-hidden="true">
            {[8, 16, 11, 20, 13, 18, 9, 15].map((h) => <span style={`height:${h}px`} />)}
          </span>
          <span class="mono">{dl.podcast.link.label}</span>
        </a>
      </Surface>
    </div>

    <div class="hs-block hs-out">
      <div class="hs-out__main" data-reveal>
        <p class="mono faint">{frc.outreach.label}</p>
        <h3 class="hs-out__h cond">{frc.outreach.heading}</h3>
        <p class="hs-lead">{frc.outreach.text}</p>
        <p class="hs-out__stat">
          <span class="huge litx hs-out__val">{frc.outreach.stat.value}</span>
          <span class="mono faint">{frc.outreach.stat.label}</span>
        </p>
      </div>
      <figure class="hs-quote" data-reveal>
        <figcaption class="mono rim-ink">{frc.outreach.advocacy.label}</figcaption>
        <blockquote class="cond">“{frc.outreach.advocacy.quote}”</blockquote>
      </figure>
    </div>

    <div class="hs-block">
      <p class="mono faint">{frc.mentoring.label}</p>
      <ul role="list" class="hs-teams" data-reveal>
        {
          frc.mentoring.teams.map((t) => (
            <li class="hs-team">
              <span class="mono faint">FRC</span>
              <span class="huge litx hs-team__num">{t.number}</span>
              <span class="hs-team__text muted">{t.text}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hs-block" data-reveal>
      <p class="mono faint">{frc.skills.label}</p>
      <div class="hs-chips">
        {frc.skills.chips.map((c) => <Chip label={c.label} />)}
      </div>
    </div>
  </section>

  <!-- ---------- Projects ---------- -->
  <section class="section wrap" aria-labelledby="hsp-h">
    <SectionHead label={projects.label} heading={projects.heading} id="hsp-h" drift="right" />
    <ul role="list" class="hs-projects">
      {
        projects.items.map((p) => (
          <li data-reveal>
            <Surface as="article" class="hs-project">
              <p class="mono faint">{p.label}</p>
              <h3 class="hs-project__title cond">{p.title}</h3>
              <p class="hs-project__text muted">{p.text}</p>
              <div class="hs-project__foot">
                {p.award && (
                  <p class="hs-award">
                    <svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                      <circle cx="12" cy="9" r="6" />
                      <path d="M8.5 14L7 22l5-3 5 3-1.5-8" />
                    </svg>
                    <AwardLink id={p.award}>{p.awardText}</AwardLink>
                  </p>
                )}
                {p.link && (
                  <a href={p.link.href} rel="noopener" class="hs-project__link cap">
                    {p.link.label}
                    <svg class="ico" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M7 17L17 7M9 7h8v8" />
                    </svg>
                  </a>
                )}
              </div>
            </Surface>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ---------- Leadership and community ---------- -->
  <section class="section wrap" aria-labelledby="comm-h">
    <SectionHead label={community.label} heading={community.heading} id="comm-h" drift="left" size="mid" />
    {
      community.groups.map((g) => (
        <div class="hs-group">
          <h3 class="mono faint hs-group__h">{g.title}</h3>
          <ul role="list" class="hs-roles">
            {g.items.map((it) => (
              <li data-reveal>
                <Surface as="article" class="hs-role">
                  <h4 class="hs-role__name cond">{it.name}</h4>
                  <p class="mono rim-ink hs-role__role">{it.role}</p>
                  {it.text && <p class="hs-role__text muted">{it.text}</p>}
                  {'award' in it && it.award && (
                    <p class="hs-award hs-award--small">
                      <svg class="ico" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="9" r="6" />
                        <path d="M8.5 14L7 22l5-3 5 3-1.5-8" />
                      </svg>
                      <AwardLink id={it.award} />
                    </p>
                  )}
                </Surface>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <!-- ---------- Service ---------- -->
  <section class="section wrap" aria-labelledby="service-h">
    <SectionHead label={service.label} heading={service.heading} id="service-h" drift="right" />
    <p class="hs-lead hs-lead--first" data-reveal>{service.text}</p>
    <p class="hs-note muted" data-reveal>{service.other}</p>
    <ul role="list" class="hs-photos">
      {
        service.photos.map((p) => (
          <li data-reveal>
            <ImageSlot name={p.slot} alt={p.alt} sizes="(min-width: 1100px) 45vw, 100vw" />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ---------- Awards teaser ---------- -->
  <section class="wrap hs-teaser-wrap" aria-labelledby="teaser-h">
    <Surface class="hs-teaser" data-reveal>
      <div>
        <p class="mono faint">{awardsTeaser.label}</p>
        <h2 class="hs-teaser__h huge litx" id="teaser-h">{awardsTeaser.heading}</h2>
        <p class="hs-teaser__text muted">{awardsTeaser.text}</p>
      </div>
      <div class="hs-teaser__side">
        <ul role="list" class="hs-teaser__list">
          {
            awardsTeaser.ids.map((id) => (
              <li>
                <AwardLink id={id} withOrg />
              </li>
            ))
          }
        </ul>
        <a href={awardsTeaser.link.href} class="btn-accent cap hs-teaser__btn">
          {awardsTeaser.link.label}
          <svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </Surface>
  </section>
</Layout>

<style>
  .hs-lead {
    margin-top: 32px;
    max-width: 840px;
    font-size: clamp(18px, 1.39vw, 22px);
    line-height: 1.5;
  }

  .hs-lead--first {
    margin-top: 26px;
  }

  .hs-note {
    margin-top: 16px;
    font-size: 16px;
    line-height: 1.5;
  }

  .hs-kicker {
    margin-top: 64px;
  }

  .hs-block {
    margin-top: clamp(64px, 6.9vw, 120px);
  }

  .hs-chips {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* ---------- Roles timeline ---------- */
  .hstl {
    position: relative;
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 24px;
  }

  .hstl::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 9px;
    height: 2px;
    background-image: linear-gradient(90deg, var(--line2), var(--accent) 55%, var(--line2));
  }

  .hstl__item {
    position: relative;
  }

  .hstl__dot {
    display: block;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid var(--ink2);
    background-color: var(--bg);
  }

  .hstl__item--hi .hstl__dot {
    border: 0;
    background-color: var(--accent);
    box-shadow: 0 0 0 6px var(--halo-soft), 0 0 24px var(--halo);
  }

  .hstl__date {
    margin-top: 22px;
  }

  .hstl__title {
    margin-top: 6px;
    font-size: clamp(24px, 1.81vw, 30px);
    line-height: 1.08;
  }

  .hstl__text {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.47;
  }

  @media (max-width: 1099px) {
    .hstl {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding-left: 44px;
    }
    .hstl::before {
      left: 9px;
      right: auto;
      top: 4px;
      bottom: 4px;
      width: 2px;
      height: auto;
      background-image: linear-gradient(180deg, var(--line2), var(--accent) 55%, var(--line2));
    }
    .hstl__dot {
      position: absolute;
      left: -44px;
      top: 0;
    }
    .hstl__date {
      margin-top: 2px;
    }
    .hstl__text {
      max-width: 34em;
      font-size: 16px;
    }
  }

  /* ---------- Seasons ---------- */
  .hs-seasons {
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .hs-seasons :global(.hs-season) {
    height: 100%;
    padding: clamp(22px, 2.2vw, 34px);
    overflow: hidden;
    border-radius: 18px;
  }

  .hs-season__year {
    font-size: clamp(72px, 7.64vw, 134px);
    margin-bottom: 18px;
  }

  .hs-season__text {
    margin-top: 10px;
    font-size: clamp(18px, 1.39vw, 22px);
    line-height: 1.45;
  }

  @media (max-width: 899px) {
    .hs-seasons {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
  }

  /* ---------- Subteams ---------- */
  .hs-subs {
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
  }

  .hs-subs :global(.hs-sub) {
    height: 100%;
    padding: 22px;
    border-radius: 16px;
  }

  .hs-sub__name {
    display: block;
    margin-top: 26px;
    font-size: clamp(22px, 1.67vw, 28px);
    line-height: 1.1;
  }

  @media (max-width: 1099px) {
    .hs-subs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .hs-subs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }

  /* ---------- Dean's List and podcast ---------- */
  .hs-cards {
    margin-top: clamp(64px, 6.9vw, 120px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .hs-dean {
    position: relative;
    overflow: hidden;
    padding: clamp(26px, 3.06vw, 54px);
    border-radius: 20px;
    background-color: var(--card);
    border: 1.5px solid var(--accent);
    box-shadow: 0 40px 100px -40px var(--halo);
  }

  .hs-dean__fit {
    margin-top: 20px;
    container-type: inline-size;
  }

  .hs-dean__h {
    font-size: min(clamp(72px, 10.42vw, 184px), calc(100cqi / (var(--fit) * 1.004)));
  }

  .hs-dean__text {
    margin-top: 20px;
    font-size: clamp(17px, 1.25vw, 20px);
    line-height: 1.5;
  }

  .hs-dean__link {
    margin-top: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 5px;
  }

  .hs-cards :global(.hs-pod) {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(26px, 3.06vw, 54px);
    border-radius: 20px;
  }

  .hs-pod__title {
    margin-top: 18px;
    font-size: clamp(32px, 3.19vw, 56px);
    line-height: 1.09;
  }

  .hs-pod__text {
    margin-top: 14px;
    font-size: 17px;
    line-height: 1.53;
  }

  .hs-pod__link {
    margin-top: 26px;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 48px;
    color: var(--ink);
    text-decoration: none;
  }

  .hs-pod__play {
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--accent);
    color: var(--on-accent);
    box-shadow: var(--glow-shadow);
  }

  .hs-pod__play svg {
    fill: currentColor;
  }

  .hs-pod__wave {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 22px;
  }

  .hs-pod__wave span {
    width: 3px;
    background-color: var(--ink3);
  }

  @media (hover: hover) {
    .hs-pod__link:hover .mono {
      text-decoration: underline;
      text-decoration-color: var(--accent);
      text-underline-offset: 5px;
    }
  }

  @media (max-width: 899px) {
    .hs-cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- Outreach and advocacy ---------- */
  .hs-out {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px 72px;
    align-items: start;
  }

  .hs-out__h {
    margin-top: 12px;
    font-size: clamp(36px, 3.89vw, 68px);
    line-height: 1;
  }

  .hs-out .hs-lead {
    margin-top: 20px;
  }

  .hs-out__stat {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 18px;
    border-top: 1px solid var(--line2);
  }

  .hs-out__val {
    font-size: clamp(64px, 7.64vw, 134px);
  }

  .hs-quote {
    margin: 0;
    padding-left: clamp(18px, 2.2vw, 36px);
    border-left: 2px solid var(--accent);
  }

  .hs-quote blockquote {
    margin: 14px 0 0;
    font-size: clamp(22px, 1.94vw, 32px);
    line-height: 1.22;
  }

  @media (max-width: 1099px) {
    .hs-out {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- Mentoring ---------- */
  .hs-teams {
    margin: 18px 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .hs-team {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 18px;
    border-top: 1px solid var(--line2);
  }

  .hs-team__num {
    font-size: clamp(64px, 7.64vw, 134px);
  }

  .hs-team__text {
    font-size: 16px;
    line-height: 1.5;
  }

  @media (max-width: 767px) {
    .hs-teams {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
  }

  /* ---------- Projects ---------- */
  .hs-projects {
    margin: 52px 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .hs-projects :global(.hs-project) {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 2.6vw, 44px);
    border-radius: 20px;
  }

  .hs-project__title {
    margin-top: 14px;
    font-size: clamp(28px, 2.5vw, 44px);
    line-height: 1.06;
  }

  .hs-project__text {
    margin-top: 14px;
    font-size: 16px;
    line-height: 1.55;
  }

  .hs-project__foot {
    margin-top: auto;
    padding-top: 22px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .hs-award {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
  }

  .hs-award .ico {
    flex: none;
    color: var(--accent);
  }

  .hs-award--small {
    margin-top: 14px;
    font-size: 14px;
  }

  .hs-project__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }

  @media (max-width: 1099px) {
    .hs-projects {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- Leadership and community ---------- */
  .hs-group {
    margin-top: 48px;
  }

  .hs-group__h {
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line2);
    font-weight: 700;
  }

  .hs-roles {
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .hs-roles :global(.hs-role) {
    height: 100%;
    padding: clamp(22px, 2.2vw, 32px);
    border-radius: 18px;
  }

  .hs-role__name {
    font-size: clamp(22px, 1.81vw, 30px);
    line-height: 1.1;
  }

  .hs-role__role {
    margin-top: 10px;
  }

  .hs-role__text {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.5;
  }

  @media (max-width: 1099px) {
    .hs-roles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .hs-roles {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }
    .hs-role__text {
      font-size: 16px;
    }
  }

  /* ---------- Photos: columns follow each slot's shape, so all three share one height ---------- */
  .hs-photos {
    margin: 52px 0 0;
    display: grid;
    grid-template-columns: 16fr 7.2fr 7.2fr;
    gap: 24px;
    align-items: start;
  }

  @media (max-width: 1099px) {
    .hs-photos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hs-photos > :first-child {
      grid-column: 1 / -1;
    }
  }


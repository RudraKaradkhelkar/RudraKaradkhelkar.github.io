---
// High School. Copy: src/content/high-school.ts. Design: design-handoff/reference/HighSchool.html,
// restructured by design-handoff/CHANGES.md section 3: FRC Team 3616 leads, then MITES Semester
// (moved from Research), projects, leadership and community, service (with the CGI volunteering
// moved from Experience, then the team photo, the FUN Robotics Network video, and the outreach
// photo), and an awards teaser. Award mentions link to /awards.
import Layout from '../layouts/Layout.astro';
import PosterHero from '../components/PosterHero.astro';
import HighSchoolArt from '../components/art/HighSchoolArt.astro';
import SectionHead from '../components/SectionHead.astro';
import Surface from '../components/Surface.astro';
import Chip from '../components/Chip.astro';
import ImageSlot from '../components/ImageSlot.astro';
import AwardLink from '../components/AwardLink.astro';
import NewTab from '../components/NewTab.astro';
import { meta, hero, frc, mites, projects, community, service, awardsTeaser } from '../content/high-school';
import { emWidth } from '../lib/fit';

const deanFit = await emWidth(frc.deansList.heading);
const dl = frc.deansList;
const media = service.media;

// The advocacy quote is regular weight with one bold phrase (Rudra, Nov 8).
const adv = frc.outreach.advocacy;
const [quoteBefore, quoteAfter, ...extra] = adv.quote.split(adv.emphasis);
if (quoteAfter === undefined || extra.length) throw new Error('high-school.ts: advocacy.emphasis must appear exactly once in advocacy.quote');
---

<Layout meta={meta}>
  <PosterHero hero={hero} headlineSize={245} artGap={24} footGap={40} padBottom={70} halo={{ y: 230, w: 1100, h: 700, alpha: 0.45 }}>
    <HighSchoolArt slot="art" />
  </PosterHero>

  <!-- ---------- FRC Team 3616 ---------- -->
  <section class="section wrap" id={frc.id} aria-labelledby="frc-h">
    <SectionHead label={frc.label} heading={frc.heading} id="frc-h" drift="left" />
    <p class="hs-lead hs-lead--first" data-reveal>{frc.intro}</p>

    <p class="mono faint hs-kicker">{frc.roles.label}</p>
    <ol role="list" class="hstl" data-reveal>
      {
        frc.roles.milestones.map((m) => (
          <li class:list={['hstl__item', { 'hstl__item--hi': m.award }]}>
            <span class="hstl__dot" aria-hidden="true" />
            <p class:list={['mono hstl__date', m.award ? 'rim-ink' : 'faint']}>{m.date}</p>
            <h3 class="hstl__title cond">{m.award ? <AwardLink id={m.award}>{m.title}</AwardLink> : m.title}</h3>
            <p class="hstl__text muted">{m.text}</p>
          </li>
        ))
      }
    </ol>

    <p class="mono faint hs-kicker">{frc.seasons.label}</p>
    <ol role="list" class="hs-seasons">
      {
        frc.seasons.items.map((s) => (
          <li data-reveal>
            <Surface as="article" class="hs-season">
              <p class="huge outline hs-season__year" aria-hidden="true">
                {s.year}
              </p>
              <p class="mono rim-ink">
                {s.year} · {s.lang}
              </p>
              <p class="hs-season__text">{s.text}</p>
            </Surface>
          </li>
        ))
      }
    </ol>
    <p class="hs-note muted" data-reveal>{frc.seasons.note}</p>

    <div class="hs-block">
      <SectionHead label={frc.leadership.label} heading={frc.leadership.heading} level={3} size="mid" drift="right" />
      <ol role="list" class="hs-subs" data-reveal>
        {
          frc.leadership.subteams.map((name, i) => (
            <li>
              <Surface class="hs-sub">
                <span class="mono faint">{String(i + 1).padStart(2, '0')}</span>
                <span class="hs-sub__name cond">{name}</span>
              </Surface>
            </li>
          ))
        }
      </ol>
      <p class="hs-lead" data-reveal>{frc.leadership.text}</p>
      <div class="hs-chips" data-reveal>
        {frc.leadership.roles.map((r) => <Chip label={r} />)}
      </div>
    </div>

    <div class="hs-cards" data-reveal>
      <div class="hs-dean">
        <p class="mono rim-ink">{dl.label}</p>
        <div class="hs-dean__fit">
          <p class="hs-dean__h huge litx" style={`--fit:${deanFit}`}>{dl.heading}</p>
        </div>
        <p class="hs-dean__text">{dl.text}</p>
        <a href={dl.link.href} class="hs-dean__link cap">
          {dl.link.label}
          <svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
      <Surface class="hs-pod">
        <div>
          <p class="mono faint">{dl.podcast.label}</p>
          <h3 class="hs-pod__title cond">{dl.podcast.title}</h3>
          <p class="hs-pod__text muted">{dl.podcast.text}</p>
        </div>
        <a href={dl.podcast.link.href} target="_blank" rel="noopener" class="hs-pod__link">
          <span class="hs-pod__play" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z" />
            </svg>
          </span>
          <span class="hs-pod__wave" aria-hidden="true">
            {[8, 16, 11, 20, 13, 18, 9, 15].map((h) => <span style={`height:${h}px`} />)}
          </span>
          <span class="mono">{dl.podcast.link.label}</span>
          <NewTab />
        </a>
      </Surface>
    </div>

    <div class="hs-block hs-out">
      <div class="hs-out__main" data-reveal>
        <p class="mono faint">{frc.outreach.label}</p>
        <h3 class="hs-out__h cond">{frc.outreach.heading}</h3>
        <p class="hs-lead">{frc.outreach.text}</p>
        <p class="hs-out__stat">
          <span class="huge litx hs-out__val">{frc.outreach.stat.value}</span>
          <span class="mono faint">{frc.outreach.stat.label}</span>
        </p>
      </div>
      <figure class="hs-quote" data-reveal>
        <figcaption class="mono rim-ink">{adv.label}</figcaption>
        <blockquote>“{quoteBefore}<strong>{adv.emphasis}</strong>{quoteAfter}”</blockquote>
      </figure>
    </div>

    <div class="hs-block">
      <p class="mono faint">{frc.mentoring.label}</p>
      <ul role="list" class="hs-teams" data-reveal>
        {
          frc.mentoring.teams.map((t) => (
            <li class="hs-team">
              <span class="mono faint">FRC</span>
              <span class="huge litx hs-team__num">{t.number}</span>
              <span class="hs-team__text muted">{t.text}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hs-block" data-reveal>
      <p class="mono faint">{frc.skills.label}</p>
      <div class="hs-chips">
        {frc.skills.chips.map((c) => <Chip label={c.label} />)}
      </div>
    </div>
  </section>

  <!-- ---------- MITES Semester ---------- -->
  <section class="section wrap" id={mites.id} aria-labelledby="mites-h">
    <SectionHead label={mites.label} heading={mites.heading} id="mites-h" drift="right" />
    <div class="hs-mites">
      <div data-reveal>
        <p class="hs-mites__title cond">{mites.title}</p>
        <p class="hs-mites__text muted">{mites.text}</p>
      </div>
      <dl class="hs-mites__stats" data-reveal>
        {
          mites.stats.map((st) => (
            <div class="hs-mites__stat">
              <dt class="mono faint">{st.label}</dt>
              <dd class="huge litx hs-mites__val">{st.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="hs-tracks">
      {
        mites.tracks.map((t) => (
          <Surface as="article" class="hs-track" data-reveal>
            <p class="mono accent-ink">{t.label}</p>
            <h3 class="hs-track__title cond">{t.title}</h3>
            <p class="hs-track__text muted">{t.text}</p>
            <div class="hs-chips">
              {t.chips.map((c) => (
                <Chip label={c.label} />
              ))}
            </div>
            <p class="hs-award hs-track__award">
              <svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="9" r="6" />
                <path d="M8.5 14L7 22l5-3 5 3-1.5-8" />
              </svg>
              <AwardLink id={t.award}>{t.awardText}</AwardLink>
            </p>
          </Surface>
        ))
      }
    </div>
  </section>

  <!-- ---------- Projects ---------- -->
  <section class="section wrap" aria-labelledby="hsp-h">
    <SectionHead label={projects.label} heading={projects.heading} id="hsp-h" drift="left" />
    <ul role="list" class="hs-projects">
      {
        projects.items.map((p) => (
          <li data-reveal>
            <Surface as="article" class="hs-project">
              <p class="mono faint">{p.label}</p>
              <h3 class="hs-project__title cond">{p.title}</h3>
              <p class="hs-project__text muted">{p.text}</p>
              <div class="hs-project__foot">
                {p.award && (
                  <p class="hs-award">
                    <svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                      <circle cx="12" cy="9" r="6" />
                      <path d="M8.5 14L7 22l5-3 5 3-1.5-8" />
                    </svg>
                    <AwardLink id={p.award}>{p.awardText}</AwardLink>
                  </p>
                )}
                {p.link && (
                  <a href={p.link.href} target="_blank" rel="noopener" class="hs-project__link cap">
                    {p.link.label}
                    <svg class="ico" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M7 17L17 7M9 7h8v8" />
                    </svg>
                    <NewTab />
                  </a>
                )}
              </div>
            </Surface>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ---------- Leadership and community ---------- -->
  <section class="section wrap" aria-labelledby="comm-h">
    <SectionHead label={community.label} heading={community.heading} id="comm-h" drift="right" size="mid" />
    {
      community.groups.map((g) => (
        <div class="hs-group">
          <h3 class="mono faint hs-group__h">{g.title}</h3>
          <ul role="list" class="hs-roles">
            {g.items.map((it) => (
              <li data-reveal>
                <Surface as="article" class="hs-role">
                  <h4 class="hs-role__name cond">{it.name}</h4>
                  <p class="mono rim-ink hs-role__role">{it.role}</p>
                  {it.text && <p class="hs-role__text muted">{it.text}</p>}
                  {'award' in it && it.award && (
                    <p class="hs-award hs-award--small">
                      <svg class="ico" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="9" r="6" />
                        <path d="M8.5 14L7 22l5-3 5 3-1.5-8" />
                      </svg>
                      <AwardLink id={it.award} />
                    </p>
                  )}
                </Surface>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <!-- ---------- Service ---------- -->
  <section class="section wrap" aria-labelledby="service-h">
    <SectionHead label={service.label} heading={service.heading} id="service-h" drift="left" />
    <p class="hs-lead hs-lead--first" data-reveal>{service.text}</p>
    <div class="hs-vol-wrap">
      <Surface as="section" class="hs-vol" aria-labelledby="vol-h" data-reveal>
        <div>
          <p class="mono faint">{service.cgi.label}</p>
          <h3 class="hs-vol__title cond" id="vol-h">{service.cgi.title}</h3>
        </div>
        <ul role="list" class="hs-vol__items">
          {
            service.cgi.items.map((it) => (
              <li class="hs-vol__item">
                <span class="huge litx hs-vol__val">{it.value}</span>
                <span class="hs-vol__text">{it.text}</span>
              </li>
            ))
          }
        </ul>
        <p class="hs-vol__note muted">{service.cgi.note}</p>
      </Surface>
    </div>
    <p class="hs-note muted" data-reveal>{service.other}</p>
    <div class="hs-media">
      <figure class="hs-media__item hs-media__team" data-reveal>
        <ImageSlot name={media.team.slot} alt={media.team.alt} sizes="(min-width: 1100px) 32vw, (min-width: 768px) 50vw, 100vw" />
        <figcaption class="hs-media__cap">{media.team.caption}</figcaption>
      </figure>
      <figure class="hs-media__item hs-media__video" data-reveal>
        {/* Click to play: until then this is a local poster and a link to YouTube, so the page makes
            no request to YouTube. The script swaps in the youtube-nocookie.com player on click. */}
        <div class="hs-yt" data-yt={media.video.youtubeId} data-yt-title={media.video.title} data-yt-play={media.video.playLabel}>
          <a href={`https://www.youtube.com/watch?v=${media.video.youtubeId}`} target="_blank" rel="noopener" class="hs-yt__link" data-yt-link>
            <ImageSlot name={media.video.poster} alt="" fill radius="0" showRatio={false} sizes="(min-width: 1100px) 22vw, (min-width: 768px) 40vw, 360px" />
            <span class="hs-yt__play" aria-hidden="true">
              <svg width="26" height="26" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg>
            </span>
            <span class="sr-only">{media.video.watchLabel}: {media.video.title}</span>
            <NewTab />
          </a>
        </div>
        <figcaption class="hs-media__cap">{media.video.caption}</figcaption>
      </figure>
      <figure class="hs-media__item hs-media__outreach" data-reveal>
        <ImageSlot name={media.outreach.slot} alt={media.outreach.alt} sizes="(min-width: 1100px) 32vw, (min-width: 768px) 50vw, 100vw" />
        <figcaption class="hs-media__cap">{media.outreach.caption}</figcaption>
      </figure>
    </div>
  </section>

  <!-- ---------- Awards teaser ---------- -->
  <section class="wrap hs-teaser-wrap" aria-labelledby="teaser-h">
    <Surface class="hs-teaser" data-reveal>
      <div>
        <p class="mono faint">{awardsTeaser.label}</p>
        <h2 class="hs-teaser__h huge litx" id="teaser-h">{awardsTeaser.heading}</h2>
        <p class="hs-teaser__text muted">{awardsTeaser.text}</p>
      </div>
      <div class="hs-teaser__side">
        <ul role="list" class="hs-teaser__list">
          {
            awardsTeaser.ids.map((id) => (
              <li>
                <AwardLink id={id} withOrg />
              </li>
            ))
          }
        </ul>
        <a href={awardsTeaser.link.href} class="btn-accent cap hs-teaser__btn">
          {awardsTeaser.link.label}
          <svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </Surface>
  </section>
</Layout>

<script>
  // Click to play: swap the poster link for the player only when a visitor asks for it, so the
  // page makes no request to YouTube before that. Ctrl/Cmd-click still opens YouTube in a tab.
  for (const box of document.querySelectorAll<HTMLElement>('[data-yt]')) {
    const link = box.querySelector<HTMLAnchorElement>('[data-yt-link]');
    const { yt: id, ytTitle: title = '', ytPlay: play = '' } = box.dataset;
    if (!link || !id) continue;
    link.removeAttribute('target');
    link.setAttribute('aria-label', `${play}: ${title}`);
    link.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      const player = document.createElement('iframe');
      player.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0&playsinline=1`;
      player.title = title;
      player.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      player.allowFullscreen = true;
      player.referrerPolicy = 'strict-origin-when-cross-origin';
      box.replaceChildren(player);
      player.focus();
    });
  }
</script>

<style>
  .hs-lead {
    margin-top: 32px;
    max-width: 840px;
    font-size: clamp(18px, 1.39vw, 22px);
    line-height: 1.5;
  }

  .hs-lead--first {
    margin-top: 26px;
  }

  .hs-note {
    margin-top: 16px;
    font-size: 16px;
    line-height: 1.5;
  }

  .hs-kicker {
    margin-top: 64px;
  }

  .hs-block {
    margin-top: clamp(64px, 6.9vw, 120px);
  }

  .hs-chips {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* ---------- Roles timeline ---------- */
  .hstl {
    position: relative;
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 24px;
  }

  .hstl::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 9px;
    height: 2px;
    background-image: linear-gradient(90deg, var(--line2), var(--accent) 55%, var(--line2));
  }

  .hstl__item {
    position: relative;
  }

  .hstl__dot {
    display: block;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid var(--ink2);
    background-color: var(--bg);
  }

  .hstl__item--hi .hstl__dot {
    border: 0;
    background-color: var(--accent);
    box-shadow: 0 0 0 6px var(--halo-soft), 0 0 24px var(--halo);
  }

  .hstl__date {
    margin-top: 22px;
  }

  .hstl__title {
    margin-top: 6px;
    font-size: clamp(24px, 1.81vw, 30px);
    line-height: 1.08;
  }

  .hstl__text {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.47;
  }

  @media (max-width: 1099px) {
    .hstl {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding-left: 44px;
    }
    .hstl::before {
      left: 9px;
      right: auto;
      top: 4px;
      bottom: 4px;
      width: 2px;
      height: auto;
      background-image: linear-gradient(180deg, var(--line2), var(--accent) 55%, var(--line2));
    }
    .hstl__dot {
      position: absolute;
      left: -44px;
      top: 0;
    }
    .hstl__date {
      margin-top: 2px;
    }
    .hstl__text {
      max-width: 34em;
      font-size: 16px;
    }
  }

  /* ---------- Seasons ---------- */
  .hs-seasons {
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .hs-seasons :global(.hs-season) {
    height: 100%;
    padding: clamp(22px, 2.2vw, 34px);
    overflow: hidden;
    border-radius: 18px;
  }

  .hs-season__year {
    font-size: clamp(72px, 7.64vw, 134px);
    margin-bottom: 18px;
  }

  .hs-season__text {
    margin-top: 10px;
    font-size: clamp(18px, 1.39vw, 22px);
    line-height: 1.45;
  }

  @media (max-width: 899px) {
    .hs-seasons {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
  }

  /* ---------- Subteams ---------- */
  .hs-subs {
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
  }

  .hs-subs :global(.hs-sub) {
    height: 100%;
    padding: 22px;
    border-radius: 16px;
  }

  .hs-sub__name {
    display: block;
    margin-top: 26px;
    font-size: clamp(22px, 1.67vw, 28px);
    line-height: 1.1;
  }

  @media (max-width: 1099px) {
    .hs-subs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .hs-subs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }

  /* ---------- Dean's List and podcast ---------- */
  .hs-cards {
    margin-top: clamp(64px, 6.9vw, 120px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .hs-dean {
    position: relative;
    overflow: hidden;
    padding: clamp(26px, 3.06vw, 54px);
    border-radius: 20px;
    background-color: var(--card);
    border: 1.5px solid var(--accent);
    box-shadow: 0 40px 100px -40px var(--halo);
  }

  .hs-dean__fit {
    margin-top: 20px;
    container-type: inline-size;
  }

  .hs-dean__h {
    font-size: min(clamp(72px, 10.42vw, 184px), calc(100cqi / (var(--fit) * 1.004)));
  }

  .hs-dean__text {
    margin-top: 20px;
    font-size: clamp(17px, 1.25vw, 20px);
    line-height: 1.5;
  }

  .hs-dean__link {
    margin-top: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 5px;
  }

  .hs-cards :global(.hs-pod) {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(26px, 3.06vw, 54px);
    border-radius: 20px;
  }

  .hs-pod__title {
    margin-top: 18px;
    font-size: clamp(32px, 3.19vw, 56px);
    line-height: 1.09;
  }

  .hs-pod__text {
    margin-top: 14px;
    font-size: 17px;
    line-height: 1.53;
  }

  .hs-pod__link {
    margin-top: 26px;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 48px;
    color: var(--ink);
    text-decoration: none;
  }

  .hs-pod__play {
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--accent);
    color: var(--on-accent);
    box-shadow: var(--glow-shadow);
  }

  .hs-pod__play svg {
    fill: currentColor;
  }

  .hs-pod__wave {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 22px;
  }

  .hs-pod__wave span {
    width: 3px;
    background-color: var(--ink3);
  }


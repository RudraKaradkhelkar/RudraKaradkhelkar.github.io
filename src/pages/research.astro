---
// Research. Copy: src/content/research.ts. Design: design-handoff/reference/Research.html.
// Privacy (DESIGN.md section 9): the UROP partner is never named; progress stays a placeholder
// until Rudra clears it. The tool, CARMA, is named (CHANGES.md section 6).
import Layout from '../layouts/Layout.astro';
import PosterHero from '../components/PosterHero.astro';
import ResearchArt from '../components/art/ResearchArt.astro';
import Surface from '../components/Surface.astro';
import Chip from '../components/Chip.astro';
import ImageSlot from '../components/ImageSlot.astro';
import SectionHead from '../components/SectionHead.astro';
import AwardLink from '../components/AwardLink.astro';
import { meta, hero, urop, alsoAtUrop, mites, shoreline } from '../content/research';
import { getSlotImage } from '../lib/slot-images';

const shorePhoto = getSlotImage(shoreline.figure.slot);
---

<Layout meta={meta}>
  <PosterHero hero={hero} headlineSize={330} class="rs-hero" artGap={0} footGap={14} padBottom={70} halo={{ y: 190, w: 920, h: 920, alpha: 0.5 }}>
    <ResearchArt slot="art" />
  </PosterHero>

  <section class="section wrap" aria-labelledby="urop-h">
    <p class="mono faint" data-reveal>{urop.label}</p>
    <h2 class="rs-h" id="urop-h">
      <span class="rs-h__line huge litx" data-drift="left">{urop.headingLine1}</span>
      <span class="rs-h__line huge outline" data-drift="right">{urop.headingLine2}</span>
    </h2>
    <p class="rs-title cond" data-reveal>{urop.title}</p>
    <div class="rs-chips" data-reveal>
      {urop.people.map((c) => <Chip label={c.label} />)}
    </div>

    <div class="rs-grid">
      <dl class="rs-blocks">
        {
          urop.blocks.map((b) => (
            <div class="rs-block" data-reveal>
              <dt class="mono accent-ink">{b.label}</dt>
              <dd class:list={['rs-block__text', { placeholder: b.placeholder }]}>{b.text}</dd>
            </div>
          ))
        }
      </dl>

      <Surface as="figure" class="rs-fig" data-reveal>
        <svg class="rs-fig__svg" role="img" aria-label={urop.figure.alt} viewBox="0 0 600 500">
          <defs>
            <filter id="ptGlow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur stdDeviation="6"></feGaussianBlur>
            </filter>
          </defs>
          <path class="art" d="M70 440 L560 440 M70 440 L70 70"></path>
          <path class="art" d="M420 440 L420 70" style="stroke-dasharray: 4 6"></path>
          <path class="art" d="M70 170 L560 170" style="stroke-dasharray: 4 6"></path>
          <rect x="420" y="70" width="140" height="100" class="rs-fig__zone"></rect>
          <circle class="node" cx="110" cy="400" r="6"></circle>
          <circle class="node" cx="150" cy="340" r="6"></circle>
          <circle class="node" cx="185" cy="410" r="6"></circle>
          <circle class="node" cx="215" cy="290" r="6"></circle>
          <circle class="node" cx="245" cy="370" r="6"></circle>
          <circle class="node" cx="275" cy="235" r="6"></circle>
          <circle class="node" cx="305" cy="385" r="6"></circle>
          <circle class="node" cx="335" cy="310" r="6"></circle>
          <circle class="node" cx="365" cy="265" r="6"></circle>
          <circle class="node" cx="395" cy="350" r="6"></circle>
          <circle class="node" cx="470" cy="320" r="6"></circle>
          <circle class="node" cx="500" cy="380" r="6"></circle>
          <circle class="node" cx="180" cy="130" r="6"></circle>
          <circle class="node" cx="300" cy="115" r="6"></circle>
          <circle cx="460" cy="130" r="10" filter="url(#ptGlow)" class="rs-fig__hot"></circle>
          <circle cx="500" cy="102" r="10" filter="url(#ptGlow)" class="rs-fig__hot"></circle>
          <circle cx="530" cy="145" r="10" filter="url(#ptGlow)" class="rs-fig__hot"></circle>
          <circle cx="460" cy="130" r="8" class="rs-fig__hot"></circle>
          <circle cx="500" cy="102" r="8" class="rs-fig__hot"></circle>
          <circle cx="530" cy="145" r="8" class="rs-fig__hot"></circle>
          <text x="560" y="466" text-anchor="end" class="rs-fig__axis">{urop.figure.axisX}</text>
          <text x="0" y="0" transform="translate(48 440) rotate(-90)" class="rs-fig__axis">{urop.figure.axisY}</text>
          <text x="490" y="62" text-anchor="middle" class="rs-fig__axis rs-fig__axis--hi">{urop.figure.highlight}</text>
        </svg>
        <figcaption>
          <span class="rs-fig__cap rs-fig__cap--l mono faint">{urop.figure.label}</span>
          <span class="rs-fig__cap rs-fig__cap--r mono faint">{urop.figure.tag}</span>
        </figcaption>
      </Surface>
    </div>
  </section>

  <section class="wrap rs-also-wrap" aria-labelledby="also-h">
    <Surface class="rs-also" data-reveal>
      <div class="rs-also__main">
        <p class="mono faint">{alsoAtUrop.label}</p>
        <h3 class="rs-also__title cond" id="also-h">{alsoAtUrop.title}</h3>
        <p class="rs-also__text muted">{alsoAtUrop.text}</p>
      </div>
      <p class="rs-also__status mono accent-ink">{alsoAtUrop.status}</p>
    </Surface>
  </section>

  <section class="section wrap" id={mites.id} aria-labelledby="mites-h">
    <SectionHead label={mites.label} heading={mites.heading} id="mites-h" drift="right" />
    <div class="rs-mites">
      <div class="rs-mites__intro" data-reveal>
        <p class="rs-title cond rs-title--tight">{mites.title}</p>
        <p class="rs-mites__text muted">{mites.text}</p>
      </div>
      <dl class="rs-mites__stats" data-reveal>
        {
          mites.stats.map((st) => (
            <div class="rs-mites__stat">
              <dt class="mono faint">{st.label}</dt>
              <dd class="huge litx rs-mites__val">{st.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="rs-tracks">
      {
        mites.tracks.map((t) => (
          <Surface as="article" class="rs-track" data-reveal>
            <p class="mono accent-ink">{t.label}</p>
            <h3 class="rs-track__title cond">{t.title}</h3>
            <p class="rs-track__text muted">{t.text}</p>
            <div class="rs-chips rs-chips--tight">
              {t.chips.map((c) => (
                <Chip label={c.label} />
              ))}
            </div>
            <p class="rs-track__award">
              <svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="9" r="6" />
                <path d="M8.5 14L7 22l5-3 5 3-1.5-8" />
              </svg>
              <AwardLink id={t.award}>{t.awardText}</AwardLink>
            </p>
          </Surface>
        ))
      }
    </div>
  </section>

  <section class="section wrap" id={shoreline.id} aria-labelledby="shore-h">
    <div class="rs-shore">
      {
        shorePhoto ? (
          <div data-reveal>
            <ImageSlot name={shoreline.figure.slot} alt={shoreline.figure.alt} ratio={620 / 440} />
          </div>
        ) : (
          <figure class="rs-shore__fig media" data-reveal>
            <svg class="rs-shore__svg" role="img" aria-label={shoreline.figure.alt} viewBox="0 0 620 440" preserveAspectRatio="none">
              <path d="M0 300 C80 280 120 320 190 300 C260 280 300 230 370 250 C440 270 470 220 540 210 C580 204 600 214 620 210 L620 440 L0 440 Z" style="fill: rgba(80,110,140,0.12)" />
              <path d="M0 280 C80 260 120 300 190 280 C260 260 300 210 370 230 C440 250 470 200 540 190 C580 184 600 194 620 190" style="fill: none; stroke-width: 10; opacity: 0.35; stroke: var(--accent)" />
              <path d="M0 300 C80 280 120 320 190 300 C260 280 300 230 370 250 C440 270 470 220 540 210 C580 204 600 214 620 210" style="fill: none; stroke: var(--ink); stroke-width: 2" />
              <path class="art" d="M0 250 C90 230 140 262 200 246 C270 228 310 180 380 196 C450 212 480 166 550 158 L620 152 M0 200 C100 184 150 210 210 196 C280 180 320 136 390 148 C460 160 490 120 560 112 L620 106 M0 150 C110 138 160 158 220 148 C290 134 330 96 400 104 C470 112 500 78 570 70 L620 66" />
              <path class="art" d="M0 340 C100 330 160 352 240 342 C320 332 380 300 460 304 C520 307 580 290 620 286 M0 380 C110 372 170 390 250 382 C330 374 390 350 470 352 C530 354 590 340 620 338" style="stroke-dasharray: 2 6" />
            </svg>
            <figcaption>
              <span class="rs-shore__cap rs-shore__cap--tl mono faint">{shoreline.figure.label}</span>
              <span class="rs-shore__cap rs-shore__cap--br mono faint">{shoreline.figure.tag}</span>
            </figcaption>
          </figure>
        )
      }
      <div class="rs-shore__body" data-reveal>
        <p class="mono faint">{shoreline.label}</p>
        <h2 class="rs-shore__title cond" id="shore-h">{shoreline.title}</h2>
        {shoreline.paragraphs.map((t) => <p class="rs-shore__text muted">{t}</p>)}
        <div class="rs-chips rs-chips--tight">
          {shoreline.chips.map((c) => <Chip label={c.label} />)}
        </div>
        <div class="rs-shore__awards">
          <p class="mono faint">{shoreline.awardsLabel}</p>
          <ul role="list" class="rs-awards">
            {
              shoreline.awards.map((id) => (
                <li>
                  <AwardLink id={id} withOrg />
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* The hub sits lower in the cropped phone graph, so the halo follows it. */
  @media (max-width: 1099px) {
    :global(.rs-hero) {
      --halo-y-at: calc((100cqi - 2 * var(--pad)) / 2.4 * .4222);
    }
  }
  @media (max-width: 767px) {
    :global(.rs-hero) {
      --halo-y-at: calc(100cqi / 1.45 * .4222);
    }
  }

  /* ---------- UROP ---------- */
  .rs-h {
    margin-top: 20px;
    font-weight: inherit;
  }

  .rs-h__line {
    display: block;
    font-size: clamp(56px, 10.42vw, 184px);
  }

  .rs-title {
    margin-top: 32px;
    max-width: 900px;
    font-size: clamp(26px, 2.22vw, 38px);
    line-height: 1.19;
  }

  .rs-chips {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .rs-chips--tight {
    margin-top: 22px;
    gap: 8px;
  }

  .rs-grid {
    margin-top: 76px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 46.3%);
    gap: clamp(40px, 5vw, 88px);
    align-items: start;
  }

  .rs-blocks {
    margin: 0;
  }

  .rs-block {
    padding: 30px 0;
    border-top: 1px solid var(--line2);
  }

  .rs-block:last-child {
    border-bottom: 1px solid var(--line2);
  }

  .rs-block__text {
    margin: 14px 0 0;
    font-size: clamp(17px, 1.32vw, 21px);
    line-height: 1.53;
  }

  .rs-grid :global(.rs-fig) {
    margin: 0;
    aspect-ratio: 600 / 500;
    overflow: hidden;
    border-radius: 20px;
  }

  .rs-fig__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .rs-fig__zone {
    fill: var(--halo-soft);
  }

  .rs-fig__hot {
    fill: var(--accent);
  }

  .rs-fig__axis {
    fill: var(--ink2);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: .08em;
  }

  .rs-fig__axis--hi {
    fill: var(--ink);
  }

  .rs-fig__cap {
    position: absolute;
    top: 22px;
  }
  .rs-fig__cap--l {
    left: 24px;
  }
  .rs-fig__cap--r {
    right: 24px;
  }

  @media (max-width: 899px) {
    .rs-grid {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 56px;
    }
    .rs-grid :global(.rs-fig) {
      max-width: 600px;
    }
  }

  /* Phones: the axis labels would shrink below legible, so the chart text grows with the box. */
  @media (max-width: 767px) {
    .rs-fig__axis {
      font-size: 18px;
    }
    /* "HIGH ON BOTH" sits under the top-right corner, so the tag moves to the free corner. */
    .rs-fig__cap--r {
      top: auto;
      right: auto;
      left: 24px;
      bottom: 18px;
    }
  }

  /* ---------- Also at the UROP ---------- */
  .rs-also-wrap {
    padding-top: clamp(72px, 9vw, 160px);
  }

  .rs-also-wrap :global(.rs-also) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: clamp(26px, 3.06vw, 54px);
    overflow: hidden;
    border-radius: 20px;
  }

  .rs-also__main {
    max-width: 820px;
  }

  .rs-also__title {
    margin-top: 14px;
    font-size: clamp(32px, 3.19vw, 56px);
    line-height: 1.09;
  }

  .rs-also__text {
    margin-top: 14px;
    font-size: 17px;
    line-height: 1.53;
  }

  .rs-also__status {
    flex: none;
  }

  @media (max-width: 767px) {
    .rs-also-wrap :global(.rs-also) {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }
    .rs-also__text {
      font-size: 16px;
    }
  }

  /* ---------- Shoreline ---------- */
  .rs-shore {
    display: grid;
    grid-template-columns: minmax(0, 47.8%) minmax(0, 1fr);
    gap: clamp(40px, 5vw, 88px);
    align-items: center;
  }

  .rs-shore__fig {
    margin: 0;
    aspect-ratio: 620 / 440;
    border-radius: 20px;
  }

  .rs-shore__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .rs-shore__cap {
    position: absolute;
  }
  .rs-shore__cap--tl {
    left: 30px;
    top: 28px;
  }
  .rs-shore__cap--br {
    right: 30px;
    bottom: 26px;
  }

  .rs-shore__title {
    margin-top: 16px;
    font-size: clamp(34px, 3.75vw, 66px);
    line-height: 1.04;
  }

  .rs-shore__text {
    margin-top: 18px;
    font-size: 17px;
    line-height: 1.53;
  }

  .rs-shore__text + .rs-shore__text {
    margin-top: 12px;
  }

  .rs-shore__awards {
    margin-top: 30px;
    padding-top: 22px;
    border-top: 1px solid var(--line2);
  }

  .rs-awards {
    margin: 12px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 15px;
    line-height: 1.45;
  }

  /* ---------- MITES ---------- */
  .rs-mites {
    margin-top: 40px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px 64px;
    align-items: end;
  }

  .rs-title--tight {
    margin-top: 0;
  }

  .rs-mites__text {
    margin-top: 14px;
    max-width: 40em;
    font-size: 17px;
    line-height: 1.53;
  }

  .rs-mites__stats {
    margin: 0;
    display: flex;
    gap: 40px;
  }

  .rs-mites__stat {
    display: flex;
    flex-direction: column-reverse;
    padding-top: 18px;
    border-top: 1px solid var(--line2);
  }

  .rs-mites__stat dt {
    margin-top: 12px;
  }

  .rs-mites__val {
    margin: 0;
    font-size: clamp(56px, 6.25vw, 110px);
  }

  .rs-tracks {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .rs-tracks :global(.rs-track) {
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 2.6vw, 44px);
    border-radius: 20px;
  }

  .rs-track__title {
    margin-top: 14px;
    font-size: clamp(28px, 2.5vw, 44px);
    line-height: 1.08;
  }

  .rs-track__text {
    margin-top: 14px;
    font-size: 16px;
    line-height: 1.55;
  }

  .rs-track__award {
    margin-top: auto;
    padding-top: 22px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
  }

  .rs-track__award .ico {
    flex: none;
    color: var(--accent);
  }

  @media (max-width: 1099px) {
    .rs-mites {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 899px) {
    .rs-tracks {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 767px) {
    .rs-mites__stats {
      gap: 24px;
    }
    .rs-mites__stat {
      flex: 1 1 0;
    }
    .rs-mites__text {
      font-size: 16px;
    }
    .rs-awards {
      font-size: 16px;
    }
  }

  @media (max-width: 899px) {
    .rs-shore {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 767px) {
    .rs-shore__text {
      font-size: 16px;
    }
    .rs-shore__cap--tl {
      left: 24px;
      top: 22px;
    }
    .rs-shore__cap--br {
      right: 24px;
      bottom: 20px;
    }
  }
</style>

---
// Drawings & Life. Copy: src/content/drawings.ts. Design: design-handoff/reference/Drawings.html.
// `drawings`, `places`, and `hobbies` are lists; add an entry to add an item.
import Layout from '../layouts/Layout.astro';
import PosterHero from '../components/PosterHero.astro';
import DrawingsArt from '../components/art/DrawingsArt.astro';
import SectionHead from '../components/SectionHead.astro';
import Surface from '../components/Surface.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { meta, hero, sketchbook, drawings, life, places, outsideClass, hobbies } from '../content/drawings';
import { getSlotImage } from '../lib/slot-images';

// Placeholder shapes cycle through the design's six heights (416 px wide columns at 1440).
// A real scan keeps its natural shape.
const SHAPES = [416 / 420, 416 / 300, 416 / 300, 416 / 420, 416 / 380, 416 / 340];
const items = drawings.map((d, i) => {
  const image = getSlotImage(d.slot);
  return { ...d, ratio: image ? image.width / image.height : SHAPES[i % SHAPES.length]! };
});
// Fill the three columns top to bottom, in order, as in the design.
const per = Math.ceil(items.length / 3);
const columns = [0, 1, 2].map((c) => items.slice(c * per, (c + 1) * per));
---

<Layout meta={meta}>
  <PosterHero hero={hero} headlineSize={325} artGap={10} footGap={10} padBottom={110} halo={{ y: 340, w: 1100, h: 820, alpha: 0.14, center: 'rgba(255, 236, 200, .16)' }}>
    <DrawingsArt slot="art" />
  </PosterHero>

  <section class="section wrap" aria-labelledby="sketch-h">
    <SectionHead label={sketchbook.label} heading={sketchbook.heading} meta={sketchbook.count} id="sketch-h" drift="left" />
    <div class="sk">
      {
        columns.map((col, c) => (
          <ul role="list" class:list={['sk__col', `sk__col--${c}`]}>
            {col.map((d) => (
              <li class="sk__item lift" data-reveal>
                <ImageSlot name={d.slot} alt={d.title} ratio={d.ratio} label={d.medium} showRatio={false} radius="14px" sizes="(min-width: 768px) 30vw, 100vw" />
                <p class="sk__meta">
                  <span class:list={['cond sk__title', { placeholder: d.title.startsWith('[') }]}>{d.title}</span>
                  <span class="mono faint">{d.year}</span>
                </p>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </section>

  <section class="section wrap" aria-labelledby="places-h">
    <SectionHead label={life.label} heading={life.heading} id="places-h" drift="right" />
    <ul role="list" class="places">
      {
        places.map((p) => (
          <li data-reveal>
            <Surface as="article" lift class="place">
              <ImageSlot name={p.slot} alt={p.alt} label={p.coords} showRatio={false} radius="0" class="zoom" sizes="(min-width: 1100px) 30vw, 100vw" />
              <div class="place__body">
                <p class="mono faint">{p.label}</p>
                <h3 class="place__title cond">{p.title}</h3>
                <p class:list={['place__text muted', { placeholder: p.text.startsWith('[') }]}>{p.text}</p>
              </div>
            </Surface>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap hob-wrap" aria-labelledby="hob-h">
    <h2 class="mono faint" id="hob-h">{outsideClass.label}</h2>
    <ul role="list" class="hob" data-reveal>
      {
        hobbies.map((h) => (
          <li class:list={['hob__pill cond', h.highlight ? 'hob__pill--hi' : h.placeholder ? 'hob__pill--ph' : 'ghost']}>{h.label}</li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  /* ---------- Sketchbook: three staggered columns ---------- */
  .sk {
    margin-top: 52px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    align-items: start;
  }

  .sk__col {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .sk__col--1 {
    margin-top: clamp(24px, 4.17vw, 72px);
  }
  .sk__col--2 {
    margin-top: clamp(12px, 1.67vw, 30px);
  }

  .sk__meta {
    margin-top: 14px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .sk__title {
    font-size: clamp(20px, 1.53vw, 26px);
  }

  @media (max-width: 767px) {
    .sk {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .sk__col--1,
    .sk__col--2 {
      margin-top: 0;
    }
  }

  /* ---------- Places ---------- */
  .places {
    margin: 52px 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .places :global(.place) {
    height: 100%;
    overflow: hidden;
    border-radius: 20px;
  }

  .place__body {
    padding: 28px;
  }

  .place__title {
    margin-top: 12px;
    font-size: clamp(30px, 2.36vw, 40px);
    line-height: 1.06;
  }

  .place__text {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.47;
  }

  @media (max-width: 1099px) {
    .places {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .places {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    .place__body {
      padding: 22px;
    }
    .place__text {
      font-size: 16px;
    }
  }

  /* ---------- Hobbies ---------- */
  .hob-wrap {
    padding-top: clamp(80px, 10.4vw, 184px);
  }

  .hob {
    margin: 26px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .hob__pill {
    min-height: 68px;
    padding: 12px 30px;
    border-radius: 34px;
    display: inline-flex;
    align-items: center;
    font-size: clamp(21px, 1.88vw, 32px);
    line-height: 1.1;
  }

  .hob__pill--hi {
    background-color: var(--accent);
    color: var(--on-accent);
    box-shadow: var(--glow-shadow);
  }

  .hob__pill--ph {
    border: 1px dashed var(--ink3);
    color: var(--ink2);
  }

  @media (max-width: 767px) {
    .hob {
      gap: 10px;
    }
    .hob__pill {
      min-height: 54px;
      padding: 10px 22px;
    }
  }
</style>

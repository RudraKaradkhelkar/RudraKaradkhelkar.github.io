---
// Experience. Copy: src/content/experience.ts. Design: design-handoff/reference/Experience.html,
// restructured by design-handoff/CHANGES.md section 5 and Rudra's review (Nov 8): CGI as three
// chapters, newest first, each with the skills it used; EcoChamps with CGI's article and its
// photo; then CAPE and LPSS as their own sections. No separate skills bank, and the CGI
// volunteering lives on High School.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PosterHero from '../components/PosterHero.astro';
import ExperienceArt from '../components/art/ExperienceArt.astro';
import SectionHead from '../components/SectionHead.astro';
import Surface from '../components/Surface.astro';
import Chip from '../components/Chip.astro';
import ImageSlot from '../components/ImageSlot.astro';
import NewTab from '../components/NewTab.astro';
import { meta, hero, cgi, ecochamps, cape, lpss } from '../content/experience';
import { getSlotImage } from '../lib/slot-images';
import { emWidth } from '../lib/fit';

const ecoFit = await emWidth(ecochamps.heading);
const pressPhoto = getSlotImage(ecochamps.press.photo.slot);
const roles = [cape, lpss];
---

<Layout meta={meta}>
  <PosterHero hero={hero} headlineSize={280} artGap={10} footGap={84} padBottom={70} halo={{ y: 336, w: 1100, h: 800, alpha: 0.45 }}>
    <ExperienceArt slot="art" />
  </PosterHero>

  <!-- ---------- CGI, three chapters, newest first ---------- -->
  <section class="section wrap" id={cgi.id} aria-labelledby="cgi-h">
    <SectionHead label={cgi.label} heading={cgi.heading} id="cgi-h" drift="left" />
    <p class="x-intro" data-reveal>{cgi.intro}</p>

    <div class="x-thru" data-reveal>
      <p class="mono faint">{cgi.throughLine.label}</p>
      <ol role="list" class="x-thru__steps">
        {
          cgi.throughLine.steps.map((st) => (
            <li class="x-thru__step">
              <span class="huge litx x-thru__year">{st.year}</span>
              <span class="x-thru__text">{st.text}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <ol role="list" class="x-chapters">
      {
        cgi.chapters.map((ch) => (
          <li data-reveal>
            <Surface as="article" class="x-ch">
              <div class="x-ch__id">
                <p class="huge outline x-ch__year" aria-hidden="true">
                  {ch.year}
                </p>
                <p class="mono faint x-ch__label">{ch.label}</p>
                <h3 class="x-ch__role cond">{ch.role}</h3>
                <p class="x-ch__team muted">{ch.team}</p>
                {ch.context && <p class="x-ch__context">{ch.context}</p>}
              </div>
              <div class="x-ch__body">
                <p class="mono faint">WHAT I BUILT</p>
                <ul role="list" class="x-ch__built">
                  {ch.built.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
                <p class="mono faint x-ch__h">SKILLS LEARNED</p>
                <div class="x-chips">
                  {ch.skills.map((sk) => (
                    <Chip label={sk.label} />
                  ))}
                </div>
                <p class="mono faint x-ch__h">RECOGNITION</p>
                <ul role="list" class="x-ch__rec">
                  {ch.recognition.map((r) => (
                    <li>
                      {r.text}{' '}
                      {r.link && (
                        <a href={r.link.href} target="_blank" rel="noopener" class="x-link">
                          {r.link.label}
                          <NewTab />
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
                <figure class="x-quote">
                  <figcaption class="mono rim-ink">IN MY WORDS</figcaption>
                  <blockquote class="cond">“{ch.quote}”</blockquote>
                </figure>
              </div>
            </Surface>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ---------- EcoChamps ---------- -->
  <section class="section wrap" aria-labelledby="eco-h">
    <div class="eco">
      <a href={ecochamps.press.link.href} target="_blank" rel="noopener" class="eco__press surface lift" data-reveal>
        {/* The article's photo. Decorative here: the link text says where it goes. */}
        <span class="eco__photo">
          {
            pressPhoto ? (
              <Image src={pressPhoto} alt="" widths={[pressPhoto.width]} sizes="(min-width: 900px) 46vw, 100vw" class="eco__img" />
            ) : (
              <ImageSlot name={ecochamps.press.photo.slot} alt="" />
            )
          }
        </span>
        <span class="eco__press-body">
          <span class="eco__press-label mono faint">{ecochamps.press.label}</span>
          <span class="eco__press-title cond">“{ecochamps.press.title}”</span>
          <span class="eco__press-cta cap">
            {ecochamps.press.link.label}
            <svg class="ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7 17L17 7M9 7h8v8" />
            </svg>
            <NewTab />
          </span>
        </span>
      </a>
      <div class="eco__body" data-reveal>
        <p class="mono faint">{ecochamps.label}</p>
        <div class="eco__fit">
          <h2 class="eco__h huge litx" id="eco-h" style={`--fit:${ecoFit}`}>{ecochamps.heading}</h2>
        </div>
        <p class="eco__text">{ecochamps.text}</p>
        <dl class="eco__facts">
          {
            ecochamps.facts.map((f) => (
              <div class="eco__fact">
                <dt class="mono faint">{f.label}</dt>
                <dd class="cond eco__fact-v">{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- ---------- CAPE, then LPSS: each its own section ---------- -->
  {
    roles.map((r, i) => (
      <section class="section wrap x-role" id={r.id} aria-labelledby={`${r.id}-h`}>
        <SectionHead label={r.label} heading={r.heading} id={`${r.id}-h`} drift={i % 2 ? 'right' : 'left'} />
        <Surface as="article" class="x-role__card" data-reveal>
          <div>
            <p class="cap muted">{r.kicker}</p>
            <h3 class="x-role__title cond">{r.title}</h3>
          </div>
          <div>
            <ul role="list" class="x-ch__built x-ch__built--first">
              {r.points.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
            <p class="mono faint x-ch__h">{r.skillsLabel}</p>
            <div class="x-chips">
              {r.skills.map((sk) => (
                <Chip label={sk.label} />
              ))}
            </div>
          </div>
        </Surface>
      </section>
    ))
  }
</Layout>

<style>
  /* ---------- CGI ---------- */
  .x-intro {
    margin-top: 26px;
    max-width: 840px;
    font-size: clamp(18px, 1.39vw, 22px);
    line-height: 1.5;
  }

  .x-thru {
    margin-top: 40px;
    padding: clamp(22px, 2.2vw, 34px) 0;
    border-top: 1px solid var(--line2);
    border-bottom: 1px solid var(--line2);
  }

  .x-thru__steps {
    margin: 18px 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 64px;
  }

  .x-thru__step {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  /* Arrow from 2024 to 2026. */
  .x-thru__step + .x-thru__step::before {
    content: '';
    position: absolute;
    left: -48px;
    top: .7em;
    width: 32px;
    height: 2px;
    background-image: linear-gradient(90deg, var(--line2), var(--accent));
  }

  .x-thru__year {
    flex: none;
    font-size: clamp(44px, 4.17vw, 72px);
  }

  .x-thru__text {
    font-size: 17px;
    line-height: 1.5;
  }

  .x-chapters {
    margin: 40px 0 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .x-chapters :global(.x-ch) {
    display: grid;
    grid-template-columns: minmax(0, 30%) minmax(0, 1fr);
    gap: 40px;
    padding: clamp(24px, 3.06vw, 54px);
    overflow: hidden;
    border-radius: 20px;
  }

  .x-ch__year {
    font-size: clamp(84px, 9.72vw, 170px);
  }

  .x-ch__label {
    margin-top: 14px;
  }

  .x-ch__role {
    margin-top: 10px;
    font-size: clamp(28px, 2.5vw, 44px);
    line-height: 1.06;
  }

  .x-ch__team {
    margin-top: 8px;
    font-size: 16px;
  }

  .x-ch__context {
    margin-top: 16px;
    padding-left: 14px;
    border-left: 2px solid var(--accent);
    font-size: 16px;
    line-height: 1.5;
  }

  .x-ch__built {
    margin: 12px 0 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .x-ch__built--first {
    margin-top: 0;
  }

  .x-ch__built li {
    position: relative;
    padding-left: 22px;
    font-size: clamp(16px, 1.11vw, 18px);
    line-height: 1.55;
  }

  .x-ch__built li::before {
    content: '';
    position: absolute;
    left: 0;
    top: .7em;
    width: 10px;
    height: 2px;
    background-color: var(--accent);
  }

  .x-ch__h {
    margin-top: 26px;
  }

  .x-chips {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .x-ch__rec {
    margin: 12px 0 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 16px;
    line-height: 1.5;
  }

  .x-link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: .22em;
  }

  .x-quote {
    margin: 28px 0 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--line);
  }

  .x-quote blockquote {
    margin: 10px 0 0;
    font-size: clamp(22px, 1.81vw, 30px);
    line-height: 1.2;
  }

  @media (max-width: 1099px) {
    .x-chapters :global(.x-ch) {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }

  @media (max-width: 767px) {
    .x-thru__steps {
      grid-template-columns: minmax(0, 1fr);
    }
    .x-thru__step + .x-thru__step::before {
      left: 18px;
      top: -20px;
      width: 2px;
      height: 16px;
      background-image: linear-gradient(180deg, var(--line2), var(--accent));
    }
    .x-ch__year {
      font-size: 84px;
    }
  }

  /* ---------- EcoChamps ---------- */
  .eco {
    display: grid;
    grid-template-columns: minmax(0, 52.5%) minmax(0, 1fr);
    gap: clamp(40px, 5vw, 88px);
    align-items: center;
  }

  /* The press card: CGI's article photo on top, the headline and link below. */
  .eco__press {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 20px;
    color: var(--ink);
    text-decoration: none;
  }

  .eco__photo {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--card2);
  }

  .eco__photo :global(.eco__img),
  .eco__photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keeps both faces and the tablet under the boy's finger; the trim comes off the bunting. */
    object-position: 50% 70%;
    transition: transform .9s var(--ease-out);
  }

  .eco__press-body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(24px, 2.6vw, 44px);
  }

  .eco__press-title {
    font-size: clamp(28px, 2.5vw, 44px);
    line-height: 1.08;
    max-width: 16em;
  }

  .eco__press-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
  }

  @media (hover: hover) {
    .eco__press:hover .eco__press-cta {
      text-decoration: underline;
      text-decoration-color: var(--accent);
      text-underline-offset: 6px;
    }
    .eco__press:hover .eco__photo :global(img) {
      transform: scale(1.03);
    }
  }

  /* The heading is fitted to its column (it overflowed the column in the design file). */
  .eco__fit {
    margin-top: 18px;
    container-type: inline-size;
  }

  .eco__h {
    font-size: min(calc(100cqi / (var(--fit) * 1.004)), 150px);
  }

  .eco__text {
    margin-top: 22px;
    font-size: clamp(17px, 1.25vw, 20px);
    line-height: 1.56;
  }

  .eco__facts {
    margin: 30px 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .eco__fact {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding-top: 18px;
    border-top: 1px solid var(--line2);
  }

  .eco__fact dt {
    margin-top: 8px;
  }

  .eco__fact-v {
    margin: 0;
    font-size: clamp(28px, 2.5vw, 42px);
    line-height: 1.1;
  }

  @media (max-width: 899px) {
    .eco {
      grid-template-columns: minmax(0, 1fr);
    }
    .eco__press {
      max-width: 640px;
    }
  }

  /* ---------- CAPE and LPSS ---------- */
  .x-role :global(.x-role__card) {
    margin-top: 40px;
    display: grid;
    grid-template-columns: minmax(0, 34%) minmax(0, 1fr);
    gap: 40px;
    padding: clamp(24px, 3.06vw, 54px);
    border-radius: 20px;
  }

  .x-role__title {
    margin-top: 10px;
    font-size: clamp(30px, 2.78vw, 46px);
    line-height: 1.05;
  }

  @media (max-width: 1099px) {
    .x-role :global(.x-role__card) {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }
</style>

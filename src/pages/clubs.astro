---
// Clubs. Copy: src/content/clubs.ts. Design: design-handoff/reference/Clubs.html.
// `clubs` is a list (CHANGES.md section 7: four clubs).
import Layout from '../layouts/Layout.astro';
import PosterHero from '../components/PosterHero.astro';
import ClubsArt from '../components/art/ClubsArt.astro';
import SectionHead from '../components/SectionHead.astro';
import Surface from '../components/Surface.astro';
import Chip from '../components/Chip.astro';
import { meta, hero, current, clubs } from '../content/clubs';

const num = (i: number) => String(i + 1).padStart(2, '0');
---

<Layout meta={meta}>
  <PosterHero hero={hero} headlineSize={518} artGap={4} footGap={30} padBottom={90} halo={{ y: 194, w: 1100, h: 900, alpha: 0.42 }}>
    <ClubsArt slot="art" />
  </PosterHero>

  <section class="section wrap" aria-labelledby="clubs-h">
    <SectionHead label={current.label} heading={current.heading} id="clubs-h" drift="left" />
    <ol role="list" class="clubs">
      {
        clubs.map((c, i) => (
          <li data-reveal>
            <Surface as="article" class="club">
              <p class="club__num huge outline" aria-hidden="true">
                {num(i)}
              </p>
              <div class="club__head">
                <p class="mono faint">{c.role}</p>
                <h3 class="club__name cond">{c.name}</h3>
                {c.chips.length > 0 && (
                  <div class="club__chips">
                    {c.chips.map((chip) => (
                      <Chip label={chip.label} />
                    ))}
                  </div>
                )}
              </div>
              {(c.paragraphs.length > 0 || c.link) && (
                <div class="club__body">
                  {c.paragraphs.map((p) => (
                    <p class="club__text">{p}</p>
                  ))}
                  {c.link && (
                    <a href={c.link.href} class="club__link mono rim-ink">
                      {c.link.label}
                      <svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" />
                      </svg>
                    </a>
                  )}
                </div>
              )}
            </Surface>
          </li>
        ))
      }
    </ol>
  </section>
</Layout>

<style>
  .clubs {
    margin: 52px 0 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* 200 / 400 / rest of the 1208 px inner width at 1440. */
  .clubs :global(.club),
  .club {
    display: grid;
    grid-template-columns: minmax(0, 16.6%) minmax(0, 33.1%) minmax(0, 1fr);
    gap: 40px;
    padding: clamp(24px, 3.06vw, 54px);
    overflow: hidden;
    border-radius: 20px;
  }

  .club--open {
    border-style: dashed;
  }

  .club__num {
    font-size: clamp(84px, 9.72vw, 170px);
  }

  .club__name {
    margin-top: 12px;
    font-size: clamp(32px, 2.92vw, 50px);
    line-height: 1.05;
  }

  .club__chips {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .club__text {
    font-size: 17px;
    line-height: 1.53;
  }

  .club__link {
    margin-top: 20px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    text-decoration: none;
  }

  @media (hover: hover) {
    .club__link:hover {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  @media (max-width: 1099px) {
    .clubs :global(.club),
    .club {
      grid-template-columns: minmax(0, 22%) minmax(0, 1fr);
      gap: 24px 32px;
    }
    .club__body {
      grid-column: 2;
    }
  }

  @media (max-width: 767px) {
    .clubs {
      gap: 16px;
    }
    .clubs :global(.club),
    .club {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }
    .club__body {
      grid-column: 1;
    }
    .club__num {
      font-size: 84px;
    }
    .club__text {
      font-size: 16px;
    }
  }
</style>

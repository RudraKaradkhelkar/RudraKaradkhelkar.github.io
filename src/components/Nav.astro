---
// Fixed top nav (DESIGN.md section 5.1). R/K wordmark, section links with an accent underline on
// the current page, outline Resume pill, outline round theme toggle. Home adds a round avatar
// and turns the wordmark into a "replay intro" button; Projects adds the selection sound toggle.
// Under 1100 px the section links collapse into a menu button that opens a small popup panel.
import { Image } from 'astro:assets';
import { site } from '../content/site';
import { getSlotImage } from '../lib/slot-images';
import NewTab from './NewTab.astro';

interface Props {
  variant?: 'home' | 'projects' | 'default';
}

const { variant = 'default' } = Astro.props;
const L = site.navLabels;
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
const here = norm(Astro.url.pathname);
const isCurrent = (href: string) => norm(href) === here;
// Home's avatar: the dark-background headshot in the dark theme, the wood one in the light theme.
const headshot = getSlotImage('headshot');
const headshotDark = getSlotImage('headshot-dark');
const menuLinks = [...site.nav, site.links.resume];
---

<header class="nav" data-nav>
  <div class="nav__inner wrap">
    <div class="nav__brand">
      {
        variant === 'home' && (
          <span class="nav__avatar" data-nav-avatar>
            {headshot ? (
              <>
                <Image src={headshot} alt="" width={72} height={72} class="nav__avatar-img nav__avatar-img--light" loading="eager" />
                {headshotDark && (
                  <Image src={headshotDark} alt="" width={72} height={72} class="nav__avatar-img nav__avatar-img--dark" loading="eager" />
                )}
              </>
            ) : (
              <svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true">
                <circle cx="18" cy="18" r="17" class="nav__avatar-ring" />
                <circle cx="18" cy="14" r="5.5" class="nav__avatar-fig" />
                <path d="M7 31 C8 24 12 21.5 18 21.5 C24 21.5 28 24 29 31 Z" class="nav__avatar-fig" />
              </svg>
            )}
          </span>
        )
      }
      {
        variant === 'home' ? (
          <button type="button" class="nav__mark huge" aria-label={`${site.shortName}, ${L.replayIntro}`} data-replay-intro>
            {site.shortName}
          </button>
        ) : (
          <a href="/" class="nav__mark huge" aria-label={`${site.shortName}, ${L.home}`}>
            {site.shortName}
          </a>
        )
      }
    </div>

    <nav class="nav__links cap" aria-label={L.sections}>
      {
        site.nav.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__actions">
      <a
        href={site.links.resume.href}
        class="nav__pill cap ghost rbtn"
        aria-current={isCurrent(site.links.resume.href) ? 'page' : undefined}>{site.links.resume.label}</a
      >
      {
        variant === 'projects' && (
          <button type="button" class="nav__icon-btn ghost rbtn" aria-label={L.sound} aria-pressed="false" data-sound-toggle>
            <svg class="ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 9v6h4l5 4V5L8 9H4z" />
              <path class="nav__sound-on" d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" />
              <path class="nav__sound-off" d="M17 9l5 6M22 9l-5 6" />
            </svg>
          </button>
        )
      }
      <button
        type="button"
        class="nav__icon-btn ghost rbtn"
        aria-label={site.defaultTheme === 'light' ? L.themeToDark : L.themeToLight}
        data-theme-toggle
        data-label-to-dark={L.themeToDark}
        data-label-to-light={L.themeToLight}>
        <svg class="ico nav__sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="ico nav__moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
        </svg>
      </button>
      <button
        type="button"
        class="nav__icon-btn nav__menu-btn ghost rbtn"
        aria-label={L.menuOpen}
        aria-controls="site-menu"
        aria-expanded="false"
        popovertarget="site-menu"
        data-menu-btn>
        <span class="nav__burger" aria-hidden="true"><span></span><span></span></span>
      </button>
      {/* Under 1100 px: a small popup panel under the menu button (Rudra, Nov 8), not a full
          screen. The Popover API closes it on a click outside, on Esc, or on the button again. */}
      <div id="site-menu" class="menu" popover data-menu>
        <nav aria-label={L.sections}>
          <ul role="list" class="menu__list">
            {
              menuLinks.map((link, i) => (
                <li style={`--mi:${i}`}>
                  <a href={link.href} class="menu__link cond" aria-current={isCurrent(link.href) ? 'page' : undefined}>
                    <span>{link.label}</span>
                    <svg class="ico menu__arrow" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="menu__foot">
          <a href={`mailto:${site.email}`} class="menu__email mono">{site.email}</a>
          <div class="menu__social cap">
            <a href={site.links.linkedin.href} target="_blank" rel="noopener">{site.links.linkedin.label}<NewTab /></a>
            <a href={site.links.github.href} target="_blank" rel="noopener">{site.links.github.label}<NewTab /></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { THEME_STORAGE_KEY } from '../content/site';

  const root = document.documentElement;

  // Theme toggle: dark and light tokens, saved in localStorage. The inline script in Layout
  // applies the saved theme before first paint, so there is no flash of the wrong theme.
  const themeButtons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const syncTheme = () => {
    const light = root.dataset.theme === 'light';
    themeButtons.forEach((b) => {
      b.setAttribute('aria-label', (light ? b.dataset.labelToDark : b.dataset.labelToLight) ?? '');
    });
    themeColor?.setAttribute('content', getComputedStyle(root).getPropertyValue('--bg').trim());
  };
  themeButtons.forEach((b) =>
    b.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem(THEME_STORAGE_KEY, next);
      } catch {
        // Storage can be blocked (private mode); the toggle still works for this page view.
      }
      syncTheme();
      window.dispatchEvent(new CustomEvent('rk:theme', { detail: { theme: next } }));
    }),
  );
  syncTheme();

  // Projects selection sound: off until the visitor turns it on. Not remembered between visits.
  const sound = document.querySelector<HTMLButtonElement>('[data-sound-toggle]');
  sound?.addEventListener('click', () => {
    const on = sound.getAttribute('aria-pressed') !== 'true';
    sound.setAttribute('aria-pressed', String(on));
    root.dataset.sound = on ? 'on' : 'off';
    window.dispatchEvent(new CustomEvent('rk:sound', { detail: { on } }));
  });

  // Home: the wordmark replays the intro. The intro itself listens for this event.
  document.querySelector('[data-replay-intro]')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('rk:replay'));
  });

  // Nav background after 260 px of scroll (DESIGN.md section 5.1). Works with Lenis too,
  // because Lenis scrolls the window.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  let ticking = false;
  const syncNav = () => {
    ticking = false;
    nav?.toggleAttribute('data-scrolled', window.scrollY > 260);
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(syncNav);
      }
    },
    { passive: true },
  );
  syncNav();

  // Popup menu under 1100 px. The button's popovertarget opens and closes it, and the Popover API
  // closes it on a click outside or on Esc (returning focus to the button). This keeps
  // aria-expanded in step for the icon animation and for screen readers.
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  if (menu && menuBtn) {
    const supported = typeof menu.togglePopover === 'function';
    const isOpen = () => (supported ? menu.matches(':popover-open') : menu.hasAttribute('data-open'));
    const sync = () => menuBtn.setAttribute('aria-expanded', String(isOpen()));
    menu.addEventListener('toggle', sync);
    const close = () => {
      if (!isOpen()) return;
      if (supported) menu.hidePopover();
      else menu.removeAttribute('data-open');
      sync();
    };
    if (!supported) {
      // Browsers without the Popover API: the same popup, opened and closed by hand.
      menuBtn.addEventListener('click', () => {
        menu.toggleAttribute('data-open');
        sync();
      });
      document.addEventListener('click', (e) => {
        const t = e.target as Node;
        if (!menu.contains(t) && !menuBtn.contains(t)) close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen()) {
          close();
          menuBtn.focus();
        }
      });
    }
    // The menu button only exists under 1100 px; close the popup if the window grows past that.
    window.matchMedia('(min-width: 1100px)').addEventListener('change', (e) => {
      if (e.matches) close();
    });
  }
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 30;
    border-bottom: 1px solid transparent;
    transition: background-color .3s ease, border-color .3s ease;
  }

  /* The only place backdrop-filter is allowed (DESIGN.md section 10). */
  .nav[data-scrolled] {
    background-color: var(--navbg);
    border-bottom-color: var(--line);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .nav__inner {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .nav__avatar {
    display: block;
    width: 36px;
    height: 36px;
    flex: none;
  }

  .nav__avatar-ring {
    fill: var(--card);
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  .nav__avatar-fig {
    fill: var(--ink2);
  }

  .nav__avatar-img {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
    object-fit: cover;
  }

  /* One headshot per theme, when both exist. */
  .nav__avatar-img--dark + .nav__avatar-img,
  .nav__avatar-img--light:has(+ .nav__avatar-img--dark) {
    display: none;
  }
  :global(:root[data-theme='light']) .nav__avatar-img--light:has(+ .nav__avatar-img--dark) {
    display: block;
  }
  :global(:root[data-theme='light']) .nav__avatar-img--dark {
    display: none;
  }

  .nav__mark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font-size: 30px;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.1vw, 30px);
  }

  .nav__links a {
    color: var(--ink2);
    text-decoration: none;
    padding-block: 6px;
    transition: color .2s ease;
  }

  .nav__links a[aria-current='page'] {
    color: var(--ink);
    padding-bottom: 4px;
    border-bottom: 2px solid var(--accent);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
  }

  .nav__pill {
    height: 40px;
    padding: 0 18px;
  }

  /* On the Resume page the pill is the current page: filled with the accent, as in the design. */
  .nav__pill[aria-current='page'] {
    border-color: var(--accent);
    background-color: var(--accent);
    color: var(--on-accent);
    box-shadow: var(--glow-shadow);
  }

  .nav__icon-btn {
    width: 40px;
    height: 40px;
    flex: none;
  }

  /* Icons swap with state, so the right one shows before any script runs. */
  .nav__moon,
  :global(:root[data-theme='light']) .nav__sun {
    display: none;
  }
  :global(:root[data-theme='light']) .nav__moon {
    display: block;
  }
  .nav__sound-on,
  [aria-pressed='true'] .nav__sound-off {
    display: none;
  }
  [aria-pressed='true'] .nav__sound-on {
    display: inline;
  }

  .nav__menu-btn {
    display: none;
  }

  @media (hover: hover) {
    .nav__links a:hover {
      color: var(--ink);
    }
  }

  /* Tap targets at least 44 px on touch screens (DESIGN.md section 11). */
  @media (pointer: coarse) {
    .nav__pill {
      height: 44px;
    }
    .nav__icon-btn {
      width: 44px;
      height: 44px;
    }
  }

  @media (max-width: 1099px) {
    .nav__links {
      display: none;
    }
    .nav__menu-btn {
      display: inline-flex;
    }
  }

  @media (max-width: 400px) {
    .nav__actions {
      gap: 8px;
    }
    .nav__pill {
      padding: 0 14px;
    }
  }

  /* ---------- Menu button: two bars that turn into an X while the popup is open ---------- */
  .nav__burger {
    position: relative;
    display: block;
    width: 18px;
    height: 14px;
  }

  .nav__burger > span {
    position: absolute;
    left: 1px;
    right: 1px;
    top: 6px;
    height: 2px;
    border-radius: 1px;
    background-color: currentColor;
    transition: transform .45s var(--ease-expo);
  }

  .nav__burger > span:first-child {
    transform: translateY(-4px);
  }

  .nav__burger > span:last-child {
    transform: translateY(4px);
  }

  .nav__menu-btn[aria-expanded='true'] {
    border-color: var(--ink2);
  }

  .nav__menu-btn[aria-expanded='true'] .nav__burger > span:first-child {
    transform: rotate(45deg);
  }

  .nav__menu-btn[aria-expanded='true'] .nav__burger > span:last-child {
    transform: rotate(-45deg);
  }

  /* ---------- Popup menu ---------- */
  /* Hidden unless open, also in browsers without the Popover API (the script toggles data-open). */
  .menu {
    display: none;
    position: fixed;
    inset: auto;
    top: calc(var(--nav-h) - 4px);
    right: var(--pad);
    width: min(320px, calc(100vw - 2 * var(--pad)));
    max-height: calc(100svh - var(--nav-h) - 12px);
    margin: 0;
    padding: 8px;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--line2);
    border-radius: 20px;
    background-color: var(--card);
    color: var(--ink);
    box-shadow: inset 0 1px 0 var(--sheen), 0 34px 80px -24px var(--shadow), 0 2px 12px rgba(0, 0, 0, .22);
    /* Grows out of the menu button. */
    transform-origin: calc(100% - 20px) 0;
    opacity: 0;
    transform: translateY(-10px) scale(.94);
    transition: opacity .22s ease, transform .4s var(--ease-expo), display .4s allow-discrete, overlay .4s allow-discrete;
  }

  .menu:popover-open {
    display: block;
    opacity: 1;
    transform: none;
  }

  .menu[data-open] {
    display: block;
    z-index: 40;
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .menu:popover-open {
      opacity: 0;
      transform: translateY(-10px) scale(.94);
    }
  }

  .menu__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu__list li + li {
    border-top: 1px solid var(--line);
  }

  /* Links drop in one after another as the popup opens. */
  .menu:popover-open .menu__list li {
    animation: menu-item .45s var(--ease-expo) backwards;
    animation-delay: calc(50ms + var(--mi, 0) * 24ms);
  }

  @keyframes menu-item {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 48px;
    padding: 0 14px;
    border-radius: 12px;
    font-size: 22px;
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    transition: background-color .2s ease;
  }

  .menu__link[aria-current='page'] span {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .menu__arrow {
    flex: none;
    color: var(--ink3);
    transition: transform .3s var(--ease-out), color .2s ease;
  }

  .menu__link[aria-current='page'] .menu__arrow {
    color: var(--accent);
  }

  .menu__foot {
    margin-top: 6px;
    padding: 10px 14px 2px;
    border-top: 1px solid var(--line2);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 20px;
  }

  .menu__email {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--ink2);
    text-decoration: none;
  }

  .menu__social {
    display: flex;
    gap: 20px;
  }

  .menu__social a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
  }

  @media (hover: hover) {
    .menu__link:hover {
      background-color: var(--card2);
    }
    .menu__link:hover .menu__arrow {
      color: var(--accent);
      transform: translateX(3px);
    }
    .menu__email:hover,
    .menu__social a:hover {
      text-decoration: underline;
      text-decoration-color: var(--accent);
      text-underline-offset: 5px;
    }
  }

  /* Short landscape screens: two columns, so every link fits without scrolling. */
  @media (orientation: landscape) and (max-height: 520px) {
    .menu {
      width: min(520px, calc(100vw - 2 * var(--pad)));
    }
    .menu__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 6px;
    }
    .menu__list li + li {
      border-top: 0;
    }
    .menu__link {
      min-height: 44px;
      font-size: 20px;
    }
  }
</style>

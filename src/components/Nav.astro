---
// Fixed top nav (DESIGN.md section 5.1). R/K wordmark, section links with an accent underline on
// the current page, outline Resume pill, outline round theme toggle. Home adds a round avatar
// and turns the wordmark into a "replay intro" button; Projects adds the selection sound toggle.
// Under 1100 px the section links collapse into a menu button that opens a full-screen poster menu.
import { Image } from 'astro:assets';
import { site } from '../content/site';
import { getSlotImage } from '../lib/slot-images';

interface Props {
  variant?: 'home' | 'projects' | 'default';
}

const { variant = 'default' } = Astro.props;
const L = site.navLabels;
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
const here = norm(Astro.url.pathname);
const isCurrent = (href: string) => norm(href) === here;
const headshot = getSlotImage('headshot');
const menuLinks = [...site.nav, site.links.resume];
---

<header class="nav" data-nav>
  <div class="nav__inner wrap">
    <div class="nav__brand">
      {
        variant === 'home' && (
          <span class="nav__avatar" data-nav-avatar>
            {headshot ? (
              <Image src={headshot} alt="" width={72} height={72} class="nav__avatar-img" loading="eager" />
            ) : (
              <svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true">
                <circle cx="18" cy="18" r="17" class="nav__avatar-ring" />
                <circle cx="18" cy="14" r="5.5" class="nav__avatar-fig" />
                <path d="M7 31 C8 24 12 21.5 18 21.5 C24 21.5 28 24 29 31 Z" class="nav__avatar-fig" />
              </svg>
            )}
          </span>
        )
      }
      {
        variant === 'home' ? (
          <button type="button" class="nav__mark huge" aria-label={L.replayIntro} data-replay-intro>
            {site.shortName}
          </button>
        ) : (
          <a href="/" class="nav__mark huge" aria-label={L.home}>
            {site.shortName}
          </a>
        )
      }
    </div>

    <nav class="nav__links cap" aria-label={L.sections}>
      {
        site.nav.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__actions">
      <a
        href={site.links.resume.href}
        class="nav__pill cap ghost rbtn"
        aria-current={isCurrent(site.links.resume.href) ? 'page' : undefined}>{site.links.resume.label}</a
      >
      {
        variant === 'projects' && (
          <button type="button" class="nav__icon-btn ghost rbtn" aria-label={L.sound} aria-pressed="false" data-sound-toggle>
            <svg class="ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 9v6h4l5 4V5L8 9H4z" />
              <path class="nav__sound-on" d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" />
              <path class="nav__sound-off" d="M17 9l5 6M22 9l-5 6" />
            </svg>
          </button>
        )
      }
      <button
        type="button"
        class="nav__icon-btn ghost rbtn"
        aria-label={site.defaultTheme === 'light' ? L.themeToDark : L.themeToLight}
        data-theme-toggle
        data-label-to-dark={L.themeToDark}
        data-label-to-light={L.themeToLight}>
        <svg class="ico nav__sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="ico nav__moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
        </svg>
      </button>
      <button
        type="button"
        class="nav__icon-btn nav__menu-btn ghost rbtn"
        aria-label={L.menuOpen}
        aria-haspopup="dialog"
        aria-controls="site-menu"
        aria-expanded="false"
        data-menu-open>
        <svg class="ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 8h16M4 16h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<dialog id="site-menu" class="menu" aria-label={L.menuTitle} data-menu>
  <div class="menu__bar wrap">
    <a href="/" class="nav__mark huge" aria-label={L.home}>{site.shortName}</a>
    <button type="button" class="nav__icon-btn ghost rbtn" aria-label={L.menuClose} data-menu-close>
      <svg class="ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>
  <div class="brk tl" aria-hidden="true"></div>
  <div class="brk tr" aria-hidden="true"></div>
  <div class="brk bl" aria-hidden="true"></div>
  <div class="brk br" aria-hidden="true"></div>
  <nav class="menu__nav wrap" aria-label={L.sections}>
    <ul role="list" class="menu__list">
      {
        menuLinks.map((link) => (
          <li>
            <a href={link.href} class="menu__link huge" aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="menu__foot wrap">
    <a href={`mailto:${site.email}`} class="menu__email cond">{site.email}</a>
    <div class="menu__social cap">
      <a href={site.links.linkedin.href} rel="noopener">{site.links.linkedin.label}</a>
      <a href={site.links.github.href} rel="noopener">{site.links.github.label}</a>
    </div>
  </div>
</dialog>

<script>
  import { THEME_STORAGE_KEY } from '../content/site';

  const root = document.documentElement;

  // Theme toggle: dark and light tokens, saved in localStorage. The inline script in Layout
  // applies the saved theme before first paint, so there is no flash of the wrong theme.
  const themeButtons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const syncTheme = () => {
    const light = root.dataset.theme === 'light';
    themeButtons.forEach((b) => {
      b.setAttribute('aria-label', (light ? b.dataset.labelToDark : b.dataset.labelToLight) ?? '');
    });
    themeColor?.setAttribute('content', getComputedStyle(root).getPropertyValue('--bg').trim());
  };
  themeButtons.forEach((b) =>
    b.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem(THEME_STORAGE_KEY, next);
      } catch {
        // Storage can be blocked (private mode); the toggle still works for this page view.
      }
      syncTheme();
      window.dispatchEvent(new CustomEvent('rk:theme', { detail: { theme: next } }));
    }),
  );
  syncTheme();

  // Projects selection sound: off until the visitor turns it on. Not remembered between visits.
  const sound = document.querySelector<HTMLButtonElement>('[data-sound-toggle]');
  sound?.addEventListener('click', () => {
    const on = sound.getAttribute('aria-pressed') !== 'true';
    sound.setAttribute('aria-pressed', String(on));
    root.dataset.sound = on ? 'on' : 'off';
    window.dispatchEvent(new CustomEvent('rk:sound', { detail: { on } }));
  });

  // Home: the wordmark replays the intro. The intro itself listens for this event.
  document.querySelector('[data-replay-intro]')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('rk:replay'));
  });

  // Nav background after 260 px of scroll (DESIGN.md section 5.1). Works with Lenis too,
  // because Lenis scrolls the window.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  let ticking = false;
  const syncNav = () => {
    ticking = false;
    nav?.toggleAttribute('data-scrolled', window.scrollY > 260);
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(syncNav);
      }
    },
    { passive: true },
  );
  syncNav();

  // Full-screen menu under 1100 px. <dialog> gives focus trapping, Esc to close, and focus return.
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  if (menu && openBtn) {
    openBtn.addEventListener('click', () => {
      menu.showModal();
      openBtn.setAttribute('aria-expanded', 'true');
      window.dispatchEvent(new CustomEvent('rk:menu', { detail: { open: true } }));
    });
    closeBtn?.addEventListener('click', () => menu.close());
    menu.addEventListener('close', () => {
      openBtn.setAttribute('aria-expanded', 'false');
      window.dispatchEvent(new CustomEvent('rk:menu', { detail: { open: false } }));
    });
    // The menu only exists under 1100 px; close it if the window grows past that.
    window.matchMedia('(min-width: 1100px)').addEventListener('change', (e) => {
      if (e.matches && menu.open) menu.close();
    });
  }
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 30;
    border-bottom: 1px solid transparent;
    transition: background-color .3s ease, border-color .3s ease;
  }

  /* The only place backdrop-filter is allowed (DESIGN.md section 10). */
  .nav[data-scrolled] {
    background-color: var(--navbg);
    border-bottom-color: var(--line);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .nav__inner {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .nav__avatar {
    display: block;
    width: 36px;
    height: 36px;
    flex: none;
  }

  .nav__avatar-ring {
    fill: var(--card);
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  .nav__avatar-fig {
    fill: var(--ink2);
  }

  .nav__avatar-img {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
    object-fit: cover;
  }

  .nav__mark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font-size: 30px;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.1vw, 30px);
  }

  .nav__links a {
    color: var(--ink2);
    text-decoration: none;
    padding-block: 6px;
    transition: color .2s ease;
  }

  .nav__links a[aria-current='page'] {
    color: var(--ink);
    padding-bottom: 4px;
    border-bottom: 2px solid var(--accent);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
  }

  .nav__pill {
    height: 40px;
    padding: 0 18px;
  }

  /* On the Resume page the pill is the current page: filled with the accent, as in the design. */
  .nav__pill[aria-current='page'] {
    border-color: var(--accent);
    background-color: var(--accent);
    color: var(--on-accent);
    box-shadow: var(--glow-shadow);
  }

  .nav__icon-btn {
    width: 40px;
    height: 40px;
    flex: none;
  }

  /* Icons swap with state, so the right one shows before any script runs. */
  .nav__moon,
  :global(:root[data-theme='light']) .nav__sun {
    display: none;
  }
  :global(:root[data-theme='light']) .nav__moon {
    display: block;
  }
  .nav__sound-on,
  [aria-pressed='true'] .nav__sound-off {
    display: none;
  }
  [aria-pressed='true'] .nav__sound-on {
    display: inline;
  }

  .nav__menu-btn {
    display: none;
  }

  @media (hover: hover) {
    .nav__links a:hover {
      color: var(--ink);
    }
  }

  /* Tap targets at least 44 px on touch screens (DESIGN.md section 11). */
  @media (pointer: coarse) {
    .nav__pill {
      height: 44px;
    }
    .nav__icon-btn {
      width: 44px;
      height: 44px;
    }
  }

  @media (max-width: 1099px) {
    .nav__links {
      display: none;
    }
    .nav__menu-btn {
      display: inline-flex;
    }
  }

  @media (max-width: 400px) {
    .nav__actions {
      gap: 8px;
    }
    .nav__pill {
      padding: 0 14px;
    }
  }

  /* ---------- Full-screen menu ---------- */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0 0 max(24px, env(safe-area-inset-bottom));
    border: 0;
    background-color: var(--bg);
    color: var(--ink);
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 1;
    transition: opacity .3s ease, display .3s allow-discrete, overlay .3s allow-discrete;
  }

  .menu[open] {
    display: flex;
    flex-direction: column;
  }

  @starting-style {
    .menu[open] {
      opacity: 0;
    }
  }

  .menu::backdrop {
    background-color: var(--bg);
  }

  /* Same film grain as the page; the dialog sits in the top layer above body::after. */
  .menu::after {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    background-image: url('/grain.png');
    background-size: 220px 220px;
    opacity: var(--grainop);
    mix-blend-mode: overlay;
  }

  :global(html:has(dialog.menu[open])) {
    overflow: hidden;
  }

  .menu .brk {
    --inset: clamp(14px, 3vw, 40px);
  }
  .menu .brk.tl { left: var(--inset); top: calc(var(--nav-h) + 8px); }
  .menu .brk.tr { right: var(--inset); top: calc(var(--nav-h) + 8px); }
  .menu .brk.bl { left: var(--inset); bottom: var(--inset); }
  .menu .brk.br { right: var(--inset); bottom: var(--inset); }

  .menu__bar {
    flex: none;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .menu__nav {
    flex: 1 0 auto;
    display: flex;
    align-items: center;
    padding-block: clamp(20px, 4svh, 48px);
  }

  .menu__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: .14em;
    font-size: clamp(32px, min(13vw, 8.6svh), 96px);
    line-height: .9;
  }

  /* Short landscape screens: two columns so all links fit without scrolling. */
  @media (orientation: landscape) and (max-height: 520px) {
    .menu__list {
      display: grid;
      grid-auto-flow: column;
      grid-template-rows: repeat(4, auto);
      column-gap: 1em;
      font-size: clamp(28px, min(9vw, 12svh), 72px);
    }
  }

  .menu__link {
    display: inline-block;
    font-size: inherit;
    line-height: inherit;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
  }

  .menu__link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: .06em;
    text-underline-offset: .1em;
  }

  .menu__foot {
    flex: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
  }

  .menu__email {
    font-size: clamp(22px, 3.4vw, 34px);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .menu__social {
    display: flex;
    gap: 24px;
  }

  .menu__social a {
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  @media (hover: hover) {
    .menu__link:not([aria-current='page']):hover {
      text-decoration: underline;
      text-decoration-color: var(--line2);
      text-decoration-thickness: .06em;
      text-underline-offset: .1em;
    }
  }
</style>

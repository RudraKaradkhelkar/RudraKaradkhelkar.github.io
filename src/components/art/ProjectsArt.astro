---
// Projects hero art: game-box covers as a level select (DESIGN.md sections 5 and 7).
// CyberDefender and Drone Glove art is copied from design-handoff/reference/Projects.html; the
// Jarvis and locked poker covers are drawn in the same style. Each cover is an inline-size
// container, so everything printed on it scales with the cover.
//
// Desktop and tablet: the covers sit in a row. Phones: a horizontal scroll-snap row with the
// selected cover centered; swiping selects. The selection logic lives in ../../scripts/level-select.ts.
// Each cover's accessible name is its own printed text (level, status, title, tag, year), so what
// a screen reader says always matches what is on the box (WCAG 2.5.3).
import { site } from '../../content/site';
import { levels, controls } from '../../content/projects';
---

<div class="lvl" data-level-select>
  <div class="lvl__row" data-box="art" role="group" aria-label={controls.groupLabel} data-level-row>
    {
      levels.map((l, i) =>
        l.locked ? (
          <div class="lvl__slot" data-level-slot data-deal style={`--dd:${(0.45 + i * 0.1).toFixed(2)}s`}>
            <button type="button" class="cv cv--locked" disabled>
              <span class="cv__in">
                <span class="cv__bar mono">
                  <span>
                    {site.shortName} · {l.level}
                  </span>
                  <span>{l.status}</span>
                </span>
                <span class="cv__screen cv__screen--locked">
                  <svg class="cv__svg" viewBox="0 0 240 182" aria-hidden="true">
                    <g transform="rotate(-12 96 92)">
                      <rect x="62" y="40" width="68" height="96" rx="8" class="cv-card" />
                      <text x="72" y="62" class="cv-card-t">A</text>
                      <path d="M96 78 C96 78 80 92 80 101 C80 108 87 112 93 108 L90 118 H102 L99 108 C105 112 112 108 112 101 C112 92 96 78 96 78 Z" class="cv-card-s" />
                    </g>
                    <g transform="rotate(10 138 92)">
                      <rect x="104" y="38" width="68" height="96" rx="8" class="cv-card" />
                      <text x="114" y="60" class="cv-card-t">K</text>
                      <path d="M138 76 C138 76 122 90 122 99 C122 106 129 110 135 106 L132 116 H144 L141 106 C147 110 154 106 154 99 C154 90 138 76 138 76 Z" class="cv-card-s" />
                    </g>
                    <g class="cv-chips">
                      <ellipse cx="190" cy="150" rx="22" ry="7" />
                      <ellipse cx="190" cy="142" rx="22" ry="7" />
                      <ellipse cx="190" cy="134" rx="22" ry="7" />
                    </g>
                  </svg>
                  <svg class="ico cv__lock-ico" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="5" y="11" width="14" height="10" rx="2" />
                    <path d="M8 11V8a4 4 0 0 1 8 0v3" />
                  </svg>
                </span>
                <span class="cv__title huge cv__title--locked">
                  {l.coverTitle.map((line) => (
                    <span class="cv__line">{line}</span>
                  ))}
                </span>
                <span class="cv__foot mono">
                  <span>{l.coverTag}</span>
                  <span>{l.coverYear}</span>
                </span>
              </span>
            </button>
          </div>
        ) : (
          <div class="lvl__slot" data-level-slot data-deal style={`--dd:${(0.45 + i * 0.1).toFixed(2)}s`}>
            <button
              type="button"
              class:list={['cv', { 'is-selected': i === 0 }]}
              aria-pressed={i === 0 ? 'true' : 'false'}
              data-level={l.id}>
              <span class="cv__in">
                <span class="cv__bar mono">
                  <span>
                    {site.shortName} · {l.level}
                  </span>
                  <span class="cv__status">{l.status}</span>
                </span>
                <span class="cv__screen scan">
                  <span class="cv__screen-glow" />
                  {l.id === 'cyber' ? (
                    <svg class="cv__svg" viewBox="0 0 240 182" aria-hidden="true">
                      <defs>
                        <filter id="sweepGlow" x="-50%" y="-50%" width="200%" height="200%">
                          <feGaussianBlur stdDeviation="5" />
                        </filter>
                      </defs>
                      <circle class="art" cx="120" cy="91" r="76" />
                      <circle class="art" cx="120" cy="91" r="52" />
                      <circle class="art" cx="120" cy="91" r="28" />
                      <path class="art" d="M44 91 L196 91 M120 15 L120 167" />
                      <g class="cv-spin" style="transform-origin: 120px 91px">
                        <path d="M120 91 L196 91 A76 76 0 0 0 173.7 37.3 Z" opacity="0.5" filter="url(#sweepGlow)" style="fill: var(--accent)" />
                        <path d="M120 91 L196 91" style="stroke-width: 2; stroke: var(--rim)" />
                      </g>
                      <circle cx="160" cy="60" r="7" filter="url(#sweepGlow)" style="fill: var(--accent)" />
                      <circle cx="160" cy="60" r="3.5" style="fill: var(--rim)" />
                      <circle cx="84" cy="122" r="3" style="fill: var(--rim)" />
                    </svg>
                  ) : l.id === 'jarvis' ? (
                    <svg class="cv__svg" viewBox="0 0 240 182" aria-hidden="true">
                      <defs>
                        <filter id="jarvisGlow" x="-50%" y="-50%" width="200%" height="200%">
                          <feGaussianBlur stdDeviation="5" />
                        </filter>
                      </defs>
                      <g class="cv-spin cv-spin--slow" style="transform-origin: 120px 91px">
                        <circle cx="120" cy="91" r="66" class="art" style="stroke-dasharray: 3 7" />
                      </g>
                      <path class="art" d="M120 60 L120 38 M144 91 L174 91 M120 122 L120 144 M96 91 L66 91" />
                      <circle class="node" cx="120" cy="26" r="11" />
                      <circle class="node" cx="186" cy="91" r="11" />
                      <circle class="node" cx="120" cy="156" r="11" />
                      <circle class="node" cx="54" cy="91" r="11" />
                      <circle cx="120" cy="26" r="3.5" style="fill: var(--rim)" />
                      <circle cx="186" cy="91" r="3.5" style="fill: var(--rim)" />
                      <circle cx="120" cy="156" r="3.5" style="fill: var(--rim)" />
                      <circle cx="54" cy="91" r="3.5" style="fill: var(--rim)" />
                      <rect x="96" y="60" width="48" height="62" rx="7" style="fill: var(--fig3); stroke: var(--line2)" />
                      <path d="M104 74 H136 M104 86 H136 M104 98 H136" style="fill: none; stroke: var(--ink3); stroke-width: 2; stroke-linecap: round" />
                      <circle cx="131" cy="111" r="7" filter="url(#jarvisGlow)" style="fill: var(--accent)" />
                      <circle cx="131" cy="111" r="3.5" style="fill: var(--rim)" />
                    </svg>
                  ) : (
                    <svg class="cv__svg" viewBox="0 0 240 182" aria-hidden="true">
                      <defs>
                        <filter id="rotorGlow" x="-50%" y="-50%" width="200%" height="200%">
                          <feGaussianBlur stdDeviation="4" />
                        </filter>
                      </defs>
                      <path d="M70 41 L170 141 M170 41 L70 141" style="fill: none; stroke: var(--ink3); stroke-width: 4; stroke-linecap: round" />
                      <circle cx="70" cy="41" r="27" style="fill: none; stroke: var(--line2); stroke-width: 1.5" />
                      <circle cx="170" cy="41" r="27" style="fill: none; stroke: var(--line2); stroke-width: 1.5" />
                      <circle cx="70" cy="141" r="27" style="fill: none; stroke: var(--line2); stroke-width: 1.5" />
                      <circle cx="170" cy="141" r="27" style="fill: none; stroke: var(--line2); stroke-width: 1.5" />
                      <g class="cv-rotor" style="transform-origin: 70px 41px">
                        <path d="M48 41 L92 41" style="stroke: var(--ink); stroke-width: 3; stroke-linecap: round; opacity: 0.8" />
                      </g>
                      <g class="cv-rotor" style="transform-origin: 170px 41px">
                        <path d="M148 41 L192 41" style="stroke: var(--ink); stroke-width: 3; stroke-linecap: round; opacity: 0.8" />
                      </g>
                      <g class="cv-rotor" style="transform-origin: 70px 141px">
                        <path d="M48 141 L92 141" style="stroke: var(--ink); stroke-width: 3; stroke-linecap: round; opacity: 0.8" />
                      </g>
                      <g class="cv-rotor" style="transform-origin: 170px 141px">
                        <path d="M148 141 L192 141" style="stroke: var(--ink); stroke-width: 3; stroke-linecap: round; opacity: 0.8" />
                      </g>
                      <rect x="100" y="76" width="40" height="30" rx="8" style="fill: var(--fig3); stroke: var(--line2)" />
                      <circle cx="120" cy="91" r="8" filter="url(#rotorGlow)" style="fill: var(--accent)" />
                      <circle cx="120" cy="91" r="4" style="fill: var(--rim)" />
                    </svg>
                  )}
                </span>
                <span class="cv__title huge litx">
                  {l.coverTitle.map((line) => (
                    <span class="cv__line">{line}</span>
                  ))}
                </span>
                <span class="cv__foot mono faint">
                  <span>{l.coverTag}</span>
                  <span>{l.coverYear}</span>
                </span>
                <span class="cv__gloss gloss" />
              </span>
              <span class="cv__ring" aria-hidden="true" />
            </button>
          </div>
        ),
      )
    }
  </div>
  <div class="lvl__shadow" aria-hidden="true"></div>
</div>

<style>
  .lvl {
    position: relative;
  }

  .lvl__row {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    gap: 2.5cqi;
  }

  .lvl__slot {
    flex: none;
    width: 18.75cqi;
  }

  /* Soft black pool under the covers. */
  .lvl__shadow {
    position: absolute;
    left: 50%;
    bottom: -4.2cqi;
    width: 69.4cqi;
    height: 6.25cqi;
    transform: translateX(-50%);
    background-image: radial-gradient(closest-side, rgba(0, 0, 0, .75), transparent);
    pointer-events: none;
  }

  /* ---------- Cover ---------- */
  .cv {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 270 / 390;
    padding: 0;
    border-radius: 18px;
    border: 1px solid var(--line2);
    background-color: var(--card);
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    box-shadow: inset 0 1px 0 var(--sheen), 0 40px 80px -30px var(--shadow);
    transition: transform .35s var(--ease-out), box-shadow .35s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .cv.is-selected {
    transform: scale(1.05);
  }

  .cv.pop {
    animation: popc .46s cubic-bezier(.3, .7, .3, 1.3);
  }

  @media (hover: hover) {
    .cv:not(.is-selected):not(:disabled):hover {
      transform: translateY(-8px);
    }
  }

  .cv:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 16px;
  }

  .cv__in {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    container-type: inline-size;
  }

  .cv__bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 12.6cqi;
    padding: 0 5.9cqi;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    color: var(--ink2);
    font-size: clamp(9px, 4.44cqi, 13px);
  }

  .cv__status {
    color: var(--rim-ink);
  }

  .cv__screen {
    position: absolute;
    left: 5.2cqi;
    right: 5.2cqi;
    top: 17.8cqi;
    height: 67.4cqi;
    border-radius: 10px;
    overflow: hidden;
    background-color: var(--bg);
  }

  .cv__screen-glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 96cqi;
    height: 96cqi;
    transform: translate(-50%, -50%);
    background-image: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 30%, transparent), transparent);
  }

  .cv__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cv__title {
    position: absolute;
    left: 6.7cqi;
    top: 91cqi;
    font-size: 21.5cqi;
    line-height: .86;
  }

  .cv__line {
    display: block;
  }

  .cv__foot {
    position: absolute;
    left: 6.7cqi;
    right: 6.7cqi;
    bottom: 5.2cqi;
    display: flex;
    justify-content: space-between;
    font-size: clamp(9px, 4.44cqi, 13px);
  }

  .cv__gloss {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Accent ring and pulse on the selected cover. */
  .cv__ring {
    position: absolute;
    inset: -10px;
    border-radius: 26px;
    border: 3px solid var(--accent);
    box-shadow: 0 0 0 6px var(--glow), 0 0 60px var(--glow);
    pointer-events: none;
    opacity: 0;
  }

  .cv.is-selected.ring-on .cv__ring {
    opacity: 1;
    animation: ring-in .38s cubic-bezier(.3, .7, .3, 1.3) both, ring-pulse 1.6s ease-in-out .5s infinite;
  }

  /* Locked cover: grayed out and dashed, like a level not yet unlocked. */
  .cv--locked {
    border: 1.5px dashed var(--line2);
    background-color: transparent;
    box-shadow: none;
    color: var(--ink2);
    cursor: not-allowed;
  }

  .cv--locked .cv__in {
    filter: grayscale(1);
    opacity: .62;
  }

  .cv__screen--locked {
    background-color: transparent;
    border: 1px dashed var(--line2);
  }

  .cv__screen--locked .cv__lock-ico {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    color: var(--ink);
  }

  .cv-card {
    fill: var(--card2);
    stroke: var(--line2);
    stroke-width: 1.5;
  }

  .cv-card-t {
    fill: var(--ink2);
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 18px;
  }

  .cv-card-s {
    fill: var(--ink3);
  }

  .cv-chips ellipse {
    fill: var(--card2);
    stroke: var(--ink3);
    stroke-width: 1.5;
  }

  .cv__title--locked {
    color: var(--ink2);
  }

  .cv--locked .cv__foot {
    color: var(--ink2);
  }

  .cv__lock {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5.2cqi;
  }

  .cv__lock-ico {
    width: 12.6cqi;
    height: 12.6cqi;
  }

  .cv__q {
    font-size: 40.7cqi;
    line-height: .9;
  }

  .cv__next {
    font-size: clamp(9px, 4.44cqi, 13px);
  }

  /* Ambient: radar sweep and drone rotors. */
  .cv-spin {
    animation: spin 4s linear infinite;
  }
  .cv-spin--slow {
    animation-duration: 24s;
  }
  .cv-rotor {
    animation: spin .45s linear infinite;
  }

  @keyframes popc {
    0% { transform: scale(1); }
    35% { transform: scale(.955); }
    72% { transform: scale(1.075); }
    100% { transform: scale(1.05); }
  }
  @keyframes ring-in {
    0% { opacity: 0; transform: scale(1.07); }
    60% { opacity: 1; transform: scale(.985); }
    100% { opacity: 1; transform: scale(1); }
  }
  @keyframes ring-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: .45; }
  }

  /* ---------- Tablet: bigger covers (four fit across) ---------- */
  @media (max-width: 1279px) {
    .lvl__slot {
      width: 20.5cqi;
    }
  }

  /* ---------- Phones: horizontal scroll-snap row, selected cover centered ---------- */
  @media (max-width: 767px) {
    .lvl__row {
      --cover-w: min(62cqi, 300px);
      justify-content: flex-start;
      gap: 18px;
      margin-inline: calc(-1 * var(--pad));
      /* Room for the first and last covers to reach the center, and for the ring and pop. */
      padding: 22px calc(50% + var(--pad) - var(--cover-w) / 2);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .lvl__row::-webkit-scrollbar {
      display: none;
    }
    .lvl__slot {
      width: var(--cover-w);
      scroll-snap-align: center;
    }
    .lvl__shadow {
      bottom: -2cqi;
      width: 90cqi;
      height: 10cqi;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cv.is-selected.ring-on .cv__ring {
      opacity: 1;
    }
  }
</style>

<script>
  import { initLevelSelect } from '../../scripts/level-select';
  initLevelSelect();
</script>

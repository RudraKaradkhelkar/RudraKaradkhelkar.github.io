---
// Experience hero art: five ID badges (CHANGES.md section 5) hanging from short accent lanyards on
// a metal rail, each swinging gently; the CGI '26 badge is accent-filled. Markup and values from
// design-handoff/reference/Experience.html, re-expressed in board units so the whole rail scales.
// The badge photos use src/assets/slots/headshot-dark.jpg.
//
// The art box is a 1000-unit-wide board. Each badge is an inline-size container, so everything
// printed on it scales with the badge.
// Phones: the same five badges, smaller and overlapping like a fanned hand, on a shorter rail.
// With a mouse, moving the pointer through the badges pushes them into a bigger swing.
import { Image } from 'astro:assets';
import { heroBadges } from '../../content/experience';
import { getSlotImage } from '../../lib/slot-images';

const photo = getSlotImage('headshot-dark') ?? getSlotImage('headshot');

const label = heroBadges.map((b) => `${b.org}, ${b.role.toLowerCase()}, ${b.year}`).join('; ');
---

<div class="xart" data-box="art" role="img" aria-label={`ID badges: ${label}`}>
  <div class="xart__rail"></div>
  {
    heroBadges.map((b, i) => (
      <div class="xart__set" style={`--i:${i};--dd:${(0.4 + i * 0.1).toFixed(2)}s`} aria-hidden="true" data-deal>
        <span class="xart__yard stripe" />
        <div class:list={['xart__swing', `xart__swing--${i}`]}>
          <div class="xart__push" data-push>
          <span class="xart__clip" />
          <div class:list={['xart__badge', b.filled ? 'xart__badge--fill' : 'surface']} data-push-hit>
            <div class="xart__in">
              <span class="xart__org huge">{b.org}</span>
              <span class="xart__who">
                <span class:list={['xart__photo', { media: !b.filled && !photo }]}>
                  {photo ? (
                    <Image src={photo} alt="" widths={[120, 240]} sizes="(min-width: 768px) 64px, 48px" class="xart__img" />
                  ) : (
                    <svg viewBox="0 0 64 78">
                      <circle cx="32" cy="30" r="12" />
                      <path d="M8 78 C10 58 20 50 32 50 C44 50 54 58 56 78 Z" />
                    </svg>
                  )}
                </span>
                <span>
                  <span class="xart__name cond">{b.name}</span>
                  <span class="xart__role mono">{b.role}</span>
                </span>
              </span>
              <span class="xart__strip" />
              <span class="xart__bottom">
                <span class:list={['xart__year huge', { outline: !b.filled }]}>{b.year}</span>
                <span class="xart__code" />
              </span>
            </div>
          </div>
          </div>
        </div>
      </div>
    ))
  }
</div>

<script>
  // Mouse sway (Rudra, Nov 8): moving the pointer through the hanging badges pushes them, and each
  // swings back on a damped spring around its clip. It adds to the gentle CSS sway underneath
  // (on .xart__swing), so the badges never stop moving on their own. Mouse and trackpad only,
  // and off with prefers-reduced-motion.
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
  const pushes = [...document.querySelectorAll<HTMLElement>('[data-push]')];
  const hits = pushes.map((p) => p.querySelector<HTMLElement>('[data-push-hit]')!);

  if (pushes.length) {
    const STIFFNESS = 38; // 1/s², a swing of about one second
    const DAMPING = 2.1; // 1/s, a few visible swings before it settles
    const KICK = 0.5; // deg/s of swing per px the pointer moves across a badge
    const MAX_ANGLE = 26;
    const state = pushes.map(() => ({ angle: 0, vel: 0 }));
    let lastX: number | null = null;
    let lastT = 0;
    let frame = 0;
    let prev = 0;

    const step = (now: number) => {
      const dt = Math.min(0.033, (now - prev) / 1000 || 0.016);
      prev = now;
      let moving = false;
      state.forEach((s, i) => {
        s.vel += (-STIFFNESS * s.angle - DAMPING * s.vel) * dt;
        s.angle = Math.max(-MAX_ANGLE, Math.min(MAX_ANGLE, s.angle + s.vel * dt));
        if (Math.abs(s.angle) > 0.02 || Math.abs(s.vel) > 0.05) moving = true;
        else s.angle = s.vel = 0;
        pushes[i].style.transform = s.angle ? `rotate(${s.angle.toFixed(3)}deg)` : '';
      });
      frame = moving ? requestAnimationFrame(step) : 0;
    };

    window.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType === 'touch' || !fine.matches || calm.matches) return;
        const now = e.timeStamp;
        if (lastX === null || now - lastT > 120) {
          lastX = e.clientX;
          lastT = now;
          return;
        }
        const dx = e.clientX - lastX;
        const dt = Math.max(1, now - lastT) / 1000;
        lastX = e.clientX;
        lastT = now;
        if (!dx) return;
        // Faster passes swing harder; a slow drift only nudges.
        const speed = Math.min(1.5, Math.max(0.3, Math.abs(dx) / dt / 700));
        let kicked = false;
        hits.forEach((el, i) => {
          const r = el.getBoundingClientRect();
          if (e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom) {
            // The total kick depends on how far the pointer travels across the badge, not on how
            // often the mouse reports. A positive rotate() swings a hanging badge's bottom to the
            // left, so moving right pushes with a negative angle.
            state[i].vel -= dx * KICK * speed;
            kicked = true;
          }
        });
        if (kicked && !frame) {
          prev = performance.now();
          frame = requestAnimationFrame(step);
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  .xart {
    /* u = one design px at 1440. The board is 1000 u wide and 400 u tall. */
    --u: calc(100cqi / 1000);
    --bw: 190;
    --step: 200;
    --x0: 5;
    --yard: 64;
    --rail-x: 50;
    --rail-w: 900;
    position: relative;
    width: min(100%, 69.4cqi);
    margin-inline: auto;
    aspect-ratio: 1000 / 400;
    container-type: inline-size;
  }

  .xart__rail {
    position: absolute;
    left: calc(var(--rail-x) * var(--u));
    top: 0;
    width: calc(var(--rail-w) * var(--u));
    height: max(4px, calc(8 * var(--u)));
    border-radius: 4px;
    background-image: linear-gradient(180deg, #EDEDF0, #8F8F96);
    box-shadow: 0 12px 26px rgba(0, 0, 0, .5);
  }

  .xart__set {
    position: absolute;
    top: 0;
    left: calc((var(--x0) + var(--i) * var(--step)) * var(--u));
    width: calc(var(--bw) * var(--u));
  }

  .xart__yard {
    position: absolute;
    left: 50%;
    top: calc(6 * var(--u));
    width: max(6px, calc(14 * var(--u)));
    height: calc(var(--yard) * var(--u) + 6 * var(--u));
    transform: translateX(-50%);
    opacity: .9;
    background-color: var(--accent);
  }

  .xart__swing {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--yard) * var(--u));
    transform-origin: 50% 0;
  }

  /* Resting angles are the design's first keyframe, so reduced motion keeps the fan. */
  .xart__swing--0 { transform: rotate(-10deg); animation: swA 6s ease-in-out infinite; }
  .xart__swing--1 { transform: rotate(-4deg); animation: swB 6.6s ease-in-out infinite; }
  .xart__swing--2 { transform: rotate(1deg); animation: swE 6.2s ease-in-out infinite; }
  .xart__swing--3 { transform: rotate(6deg); animation: swC 5.8s ease-in-out infinite; }
  .xart__swing--4 { transform: rotate(11deg); animation: swD 7s ease-in-out infinite; }

  @keyframes swA { 0%, 100% { transform: rotate(-10deg); } 50% { transform: rotate(-7deg); } }
  @keyframes swB { 0%, 100% { transform: rotate(-4deg); } 50% { transform: rotate(-1.5deg); } }
  @keyframes swE { 0%, 100% { transform: rotate(1deg); } 50% { transform: rotate(-1.5deg); } }
  @keyframes swC { 0%, 100% { transform: rotate(6deg); } 50% { transform: rotate(8.5deg); } }
  @keyframes swD { 0%, 100% { transform: rotate(11deg); } 50% { transform: rotate(8deg); } }

  /* Extra swing from the pointer, around the same pivot as the CSS sway (the clip's top). */
  .xart__push {
    transform-origin: 50% 0;
  }

  .xart__clip {
    display: block;
    margin: 0 auto;
    width: 17.1%;
    aspect-ratio: 36 / 22;
    border-radius: 6px;
    border: 1px solid rgba(0, 0, 0, .4);
    background-image: linear-gradient(180deg, #EDEDF0, #8F8F96);
  }

  .xart__badge {
    position: relative;
    margin-top: -1.9%;
    width: 100%;
    aspect-ratio: 210 / 300;
    border-radius: 14px;
    container-type: inline-size;
  }

  .xart__badge--fill {
    background-color: var(--accent);
    color: var(--on-accent);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .3), 0 40px 80px -30px var(--halo);
  }

  /* Inside a badge: 1cqi is 2.1 design px. */
  .xart__in {
    position: absolute;
    inset: 0;
    padding: 7.6cqi 8.6cqi;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .xart__org {
    font-size: 19cqi;
  }

  .xart__who {
    display: flex;
    gap: 5.7cqi;
    align-items: flex-end;
  }

  .xart__photo {
    position: relative;
    flex: none;
    width: 30.5cqi;
    aspect-ratio: 64 / 78;
    border-radius: 6px;
    overflow: hidden;
  }

  .xart__photo.media::before {
    display: none;
  }

  .xart__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .xart__photo svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: var(--ink3);
  }

  .xart__badge--fill .xart__photo {
    background-color: rgba(0, 0, 0, .18);
  }
  .xart__badge--fill .xart__photo svg {
    fill: rgba(0, 0, 0, .3);
  }

  .xart__name {
    display: block;
    font-size: 8.6cqi;
    line-height: 1.11;
  }

  .xart__role {
    display: block;
    margin-top: 1.9cqi;
    font-size: 4.3cqi;
    color: var(--ink3);
  }
  .xart__badge--fill .xart__role {
    color: inherit;
    opacity: .8;
  }

  .xart__strip {
    display: block;
    height: 2.9cqi;
    border-radius: 3px;
    background-image: linear-gradient(90deg, #8E8E95, #F2F2F5, #8E8E95, #D9D9DE);
  }
  .xart__badge--fill .xart__strip {
    background-image: linear-gradient(90deg, rgba(255, 255, 255, .35), rgba(255, 255, 255, .9), rgba(255, 255, 255, .35));
  }

  .xart__bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .xart__year {
    font-size: 30.5cqi;
  }

  .xart__code {
    width: 36.2cqi;
    height: 12.4cqi;
    background-image: repeating-linear-gradient(90deg, currentColor 0 2px, transparent 2px 3px, currentColor 3px 4px, transparent 4px 7px);
  }
  .xart__badge--fill .xart__code {
    opacity: .85;
  }

  /* Tablet: the rail takes more of the width. */
  @media (max-width: 1279px) {
    .xart {
      width: min(100%, 88cqi);
    }
  }

  /* Phones: a shorter rail and a fanned, overlapping hand of badges. */
  @media (max-width: 767px) {
    .xart {
      --bw: 300;
      --step: 165;
      --x0: 20;
      --yard: 46;
      --rail-x: 120;
      --rail-w: 760;
      width: 100%;
      aspect-ratio: 1000 / 600;
    }
  }
</style>

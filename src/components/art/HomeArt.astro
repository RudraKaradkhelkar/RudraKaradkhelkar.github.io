---
// Home hero art: Rudra, arms crossed, in front of RUDRA, with the accent stripe and its marquee
// running behind. The photo is src/assets/slots/hero-photo.webp (the cut-out from
// assets-incoming/hero/hero-cutout.png, nearly square). Without it, the stand-in SVG copied from
// design-handoff/reference/Main.html takes its place in a 640 x 760 box.
//
// Photo placement (ANSWERS.md): about 10% smaller than the first preview so the crossed arms clear
// the round badges, the head overlapping RUDRA, a soft accent rim light, and 0.9 brightness.
import { Image } from 'astro:assets';
import Marquee from '../Marquee.astro';
import { heroArt, heroBand } from '../../content/home';
import { getSlotImage } from '../../lib/slot-images';

const photo = getSlotImage('hero-photo');
---

<div class:list={['hart', { 'hart--photo': photo }]}>
  <div class="hart__band stripe" data-hero-band>
    <Marquee items={heroBand} repeat={4} class="hart__marquee" />
  </div>

  <div class="hart__fig" data-hero-figure>
    {
      photo ? (
        <Image
          src={photo}
          alt={heroArt.photoAlt}
          widths={[480, 800, 1200, 1600].filter((w) => w <= photo.width)}
          sizes="(min-width: 1760px) 838px, (min-width: 1280px) 48vw, (min-width: 768px) 56vw, 82vw"
          loading="eager"
          fetchpriority="high"
          class="hart__photo"
        />
      ) : (
        <svg class="hart__svg" role="img" aria-label={heroArt.standInAlt} viewBox="0 0 640 760">
          <defs>
            <linearGradient id="figBody" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" style="stop-color: var(--fig3)" />
              <stop offset="0.55" style="stop-color: var(--fig)" />
              <stop offset="1" style="stop-color: var(--bg)" />
            </linearGradient>
            <linearGradient id="figArm" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" style="stop-color: var(--fig3)" />
              <stop offset="1" style="stop-color: var(--fig)" />
            </linearGradient>
            <filter id="rimBlur" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="7" />
            </filter>
          </defs>
          <path
            fill="none"
            stroke-width="10"
            opacity="0.75"
            filter="url(#rimBlur)"
            style="stroke: var(--accent)"
            d="M356 240 C368 258 408 266 460 276 C516 286 556 304 574 340 C588 372 590 410 596 452 C604 486 614 520 612 560 M350 68 C368 82 376 100 376 120 C376 152 364 178 348 194"
          />
          <path
            fill="url(#figBody)"
            d="M70 760 L76 640 C52 626 30 600 28 560 C26 520 36 486 44 452 C50 410 52 372 66 340 C84 304 124 286 180 276 C232 266 272 258 284 240 C290 230 292 216 290 200 L350 200 C348 216 350 230 356 240 C368 258 408 266 460 276 C516 286 556 304 574 340 C588 372 590 410 596 452 C604 486 614 520 612 560 C610 600 588 626 564 640 L570 760 Z"
          />
          <path
            fill="url(#figBody)"
            d="M320 52 C354 52 376 80 376 120 C376 152 364 178 348 194 C338 204 330 208 320 208 C310 208 302 204 292 194 C276 178 264 152 264 120 C264 80 286 52 320 52 Z"
          />
          <path class="f2" d="M77 630 L506 562 A42 42 0 0 0 494 478 L63 540 A46 46 0 0 0 77 630 Z" />
          <path fill="url(#figArm)" d="M578 553 L147 485 A44 44 0 0 0 133 571 L562 647 A48 48 0 0 0 578 553 Z" />
          <path
            fill="none"
            stroke-width="2"
            stroke-linecap="round"
            style="stroke: var(--rim)"
            d="M356 240 C368 258 408 266 460 276 C516 286 556 304 574 340 C588 372 590 410 596 452 C604 486 614 520 612 560"
          />
          <path
            fill="none"
            stroke-width="1.6"
            stroke-linecap="round"
            style="stroke: var(--rim)"
            d="M350 68 C368 82 376 100 376 120 C376 152 364 178 348 194"
          />
          <path
            fill="none"
            stroke="rgba(255,255,255,0.2)"
            stroke-width="1.4"
            stroke-linecap="round"
            d="M290 70 C272 82 264 100 264 120 M180 276 C124 286 84 304 66 340"
          />
          <text
            x="320"
            y="716"
            text-anchor="middle"
            style="fill: var(--ink3); font-family: var(--font-mono); font-weight: 700; font-size: 10px; letter-spacing: 0.12em"
            >{heroArt.standInLabel}</text
          >
        </svg>
      )
    }
  </div>
</div>

<style>
  .hart {
    position: relative;
    display: flex;
    justify-content: center;
  }

  /* Accent stripe behind the figure, bleeding to the screen edges. 600 px from the top of a
     900 px hero in the design, which is 60.5% down the figure. */
  .hart__band {
    position: absolute;
    top: 60.5%;
    left: calc(50% - 50vw);
    right: calc(50% - 50vw);
    height: clamp(40px, 3.61cqi, 64px);
    display: flex;
    align-items: center;
    overflow: hidden;
    transform-origin: left center;
    background-color: var(--accent);
    color: var(--on-accent);
    box-shadow: 0 20px 60px -10px var(--halo), inset 0 1px 0 rgba(255, 255, 255, .25);
  }

  .hart__band :global(.hart__marquee) {
    font-weight: 800;
    font-stretch: 80%;
    font-size: clamp(13px, 1.11cqi, 19px);
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .hart__fig {
    position: relative;
    width: 44.44cqi;
    aspect-ratio: 640 / 760;
  }

  .hart__svg,
  .hart__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hart__photo {
    object-fit: contain;
    object-position: 50% 100%;
  }

  /* Under 1280 the About block and badges move under the figure, so the figure can grow. */
  @media (max-width: 1279px) {
    .hart__fig {
      width: min(56cqi, 600px);
    }
  }

  /* Phones: 82% of the width, a little less on short screens so the whole hero still fits in
     one screen, but never so small that the head stops overlapping the letters. */
  @media (max-width: 767px) {
    .hart__fig {
      width: max(62cqi, min(82cqi, calc((100svh - 440px) * .8)));
    }
  }

  /* Short landscape phones: the figure follows the screen height so the poster stays compact. */
  @media (orientation: landscape) and (max-height: 520px) {
    .hart__fig {
      width: min(44cqi, 118svh);
    }
  }

  /* ---------- The photo ----------
     The figure box is the photo's own shape (2275 x 2181). --fw is its width; the photo starts a
     little below the headline's top (15% of its width) so the head sits over the middle of the
     letters, and the band crosses the chest. At 1440: 662 px wide, top at 239, band at 600. */
  .hart--photo {
    --fw: 46cqi;
    padding-top: calc(var(--fw) * .15);
  }

  .hart--photo .hart__fig {
    width: var(--fw);
    aspect-ratio: 2275 / 2181;
  }

  .hart--photo .hart__band {
    top: calc(var(--fw) * .6707);
  }

  /* Backlit: a soft accent rim around the silhouette, brighter toward the upper right like the
     stand-in's rim light, and the photo a touch darker so it sits in the poster. */
  .hart--photo .hart__photo {
    object-fit: contain;
    object-position: 50% 100%;
    filter: brightness(.9) drop-shadow(0 0 1.5px var(--rim))
      drop-shadow(5px -4px 16px color-mix(in srgb, var(--accent) 50%, transparent));
  }

  :global(:root[data-theme='light']) .hart--photo .hart__photo {
    filter: drop-shadow(0 0 1.5px var(--rim))
      drop-shadow(5px -4px 14px color-mix(in srgb, var(--accent) 55%, transparent));
  }

  @media (max-width: 1279px) {
    .hart--photo {
      --fw: min(58cqi, 640px);
    }
  }

  @media (max-width: 767px) {
    .hart--photo {
      --fw: max(64cqi, min(86cqi, calc((100svh - 450px) * 1.02)));
    }
  }

  @media (orientation: landscape) and (max-height: 520px) {
    .hart--photo {
      --fw: min(46cqi, 120svh);
    }
  }
</style>

---
// High School hero art (CHANGES.md section 3): an FRC robot built around its bumper and the team
// number 3616, drawn in the poster's lit, rim-lighted style. The medal that used to sit here moved
// to /awards. A slow shine sweeps across the bumper (the same 4.5 s sweep the medal had).
// The art box is a 900 x 440 board and always sits below the headline.
import { heroArt } from '../../content/high-school';
---

<div class="frc" data-box="art" data-hero-figure>
  <svg class="frc__svg" role="img" aria-label={heroArt.alt} viewBox="0 0 900 440">
    <defs>
      <linearGradient id="frcMetal" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" style="stop-color: #8F8F96"></stop>
        <stop offset="0.45" style="stop-color: #EDEDF0"></stop>
        <stop offset="1" style="stop-color: #7C7C84"></stop>
      </linearGradient>
      <linearGradient id="frcDark" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: #3A3A40"></stop>
        <stop offset="1" style="stop-color: #18181B"></stop>
      </linearGradient>
      <linearGradient id="frcBumperShade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: #FFFFFF; stop-opacity: 0.28"></stop>
        <stop offset="0.35" style="stop-color: #FFFFFF; stop-opacity: 0"></stop>
        <stop offset="1" style="stop-color: #000000; stop-opacity: 0.38"></stop>
      </linearGradient>
      <linearGradient id="frcShine" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" style="stop-color: #FFFFFF; stop-opacity: 0"></stop>
        <stop offset="0.5" style="stop-color: #FFFFFF; stop-opacity: 0.45"></stop>
        <stop offset="1" style="stop-color: #FFFFFF; stop-opacity: 0"></stop>
      </linearGradient>
      <filter id="frcGlow" x="-20%" y="-50%" width="140%" height="200%">
        <feGaussianBlur stdDeviation="7"></feGaussianBlur>
      </filter>
      <clipPath id="frcBumperClip"><rect x="160" y="286" width="580" height="104" rx="32"></rect></clipPath>
    </defs>

    <!-- Floor shadow -->
    <ellipse cx="450" cy="420" rx="340" ry="16" class="frc__shadow"></ellipse>

    <!-- Wheels, peeking under the bumper -->
    <g class="frc__wheel">
      <circle cx="250" cy="392" r="28"></circle>
      <circle cx="370" cy="396" r="24"></circle>
      <circle cx="530" cy="396" r="24"></circle>
      <circle cx="650" cy="392" r="28"></circle>
    </g>

    <!-- Elevator: two uprights, cross members, and the carriage -->
    <rect x="372" y="48" width="18" height="220" rx="3" style="fill: url(#frcMetal)"></rect>
    <rect x="510" y="48" width="18" height="220" rx="3" style="fill: url(#frcMetal)"></rect>
    <rect x="372" y="56" width="156" height="12" rx="3" style="fill: url(#frcDark); stroke: #5E5E66"></rect>
    <rect x="372" y="176" width="156" height="12" rx="3" style="fill: url(#frcDark); stroke: #5E5E66"></rect>
    <rect x="356" y="112" width="188" height="44" rx="8" style="fill: url(#frcDark); stroke: #6E6E74"></rect>
    <circle cx="380" cy="134" r="6" class="frc__bolt"></circle>
    <circle cx="520" cy="134" r="6" class="frc__bolt"></circle>

    <!-- Arm and intake roller -->
    <g transform="rotate(16 540 134)">
      <rect x="536" y="124" width="170" height="20" rx="10" style="fill: url(#frcMetal)"></rect>
      <circle cx="704" cy="134" r="24" style="fill: url(#frcDark); stroke: #6E6E74; stroke-width: 2"></circle>
      <circle cx="704" cy="134" r="9" class="frc__hub"></circle>
    </g>

    <!-- Chassis and electronics -->
    <rect x="206" y="248" width="488" height="56" rx="8" style="fill: url(#frcDark); stroke: #5E5E66"></rect>
    <rect x="236" y="258" width="74" height="34" rx="4" class="frc__box"></rect>
    <rect x="590" y="258" width="74" height="34" rx="4" class="frc__box"></rect>
    <circle cx="627" cy="275" r="5" class="frc__led"></circle>

    <!-- Rim light along the top edges -->
    <path d="M390 50 L390 266 M528 50 L528 266 M544 114 L544 154" class="frc__rim" filter="url(#frcGlow)"></path>
    <path d="M390 50 L390 266 M528 50 L528 266" class="frc__rim-line"></path>

    <!-- Bumper with the team number -->
    <rect x="160" y="286" width="580" height="104" rx="32" class="frc__bumper"></rect>
    <rect x="160" y="286" width="580" height="104" rx="32" style="fill: url(#frcBumperShade)"></rect>
    <rect x="176" y="300" width="548" height="76" rx="22" class="frc__seam"></rect>
    <text x="450" y="370" text-anchor="middle" class="frc__num">{heroArt.teamNumber}</text>
    <path d="M192 287 L708 287" class="frc__rim" filter="url(#frcGlow)"></path>
    <path d="M192 287 L708 287" class="frc__rim-line"></path>
    <g style="clip-path: url(#frcBumperClip)">
      <rect class="frc__shine" x="200" y="270" width="120" height="140" style="fill: url(#frcShine)"></rect>
    </g>
  </svg>
</div>

<style>
  .frc {
    width: min(100%, 58cqi);
    margin-inline: auto;
    aspect-ratio: 900 / 440;
  }

  .frc__svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .frc__shadow {
    fill: #000000;
    opacity: .55;
  }
  :global(:root[data-theme='light']) .frc__shadow {
    opacity: .14;
  }

  .frc__wheel circle {
    fill: #141416;
    stroke: #3A3A40;
    stroke-width: 3;
  }

  .frc__bolt {
    fill: #8F8F96;
  }

  .frc__hub {
    fill: var(--accent);
  }

  .frc__box {
    fill: #232327;
    stroke: #3A3A40;
  }

  .frc__led {
    fill: var(--rim);
  }

  .frc__rim {
    fill: none;
    stroke: var(--accent);
    stroke-width: 8;
    opacity: .6;
  }

  .frc__rim-line {
    fill: none;
    stroke: var(--rim);
    stroke-width: 2;
  }

  .frc__bumper {
    fill: var(--accent);
  }

  .frc__seam {
    fill: none;
    stroke: rgba(255, 255, 255, .35);
    stroke-width: 1.5;
    stroke-dasharray: 6 6;
  }

  /* White numbers with a dark edge read on any accent, as on a real bumper. */
  .frc__num {
    fill: #FFFFFF;
    stroke: rgba(0, 0, 0, .35);
    stroke-width: 2;
    paint-order: stroke;
    font-family: var(--font-sans);
    font-weight: 900;
    font-stretch: 62%;
    font-size: 96px;
    letter-spacing: .04em;
  }

  .frc__shine {
    transform-box: fill-box;
    animation: shine 4.5s ease-in-out 2s infinite backwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .frc__shine {
      display: none;
    }
  }

  @media (max-width: 1279px) {
    .frc {
      width: min(100%, 72cqi);
    }
  }

  @media (max-width: 767px) {
    .frc {
      width: 100%;
    }
  }
</style>

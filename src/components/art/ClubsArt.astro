---
// Clubs hero art: three embroidered patches whose ring text spins slowly (48 s). SVG copied from
// design-handoff/reference/Clubs.html. The art box is a 900 x 340 board (x 270 to 1170 of the
// 1440 design); phones overlap the three patches in one row, smaller.
import { heroPatches } from '../../content/clubs';

const [a, b, c] = heroPatches as [(typeof heroPatches)[number], (typeof heroPatches)[number], (typeof heroPatches)[number]];
---

<div class="cart" data-box="art">
  <div class="cart__p cart__p--a">
    <svg role="img" aria-label={a.alt} viewBox="0 0 300 300">
      <defs>
        <filter id="patchShadowA" x="-20%" y="-20%" width="140%" height="150%">
          <feDropShadow dx="0" dy="18" stdDeviation="16" style="flood-color: #000000; flood-opacity: 0.6"></feDropShadow>
        </filter>
        <radialGradient id="patchFaceA" cx="35%" cy="25%" r="80%">
          <stop offset="0" style="stop-color: var(--card2)"></stop>
          <stop offset="1" style="stop-color: var(--card)"></stop>
        </radialGradient>
        <path id="ringA" d="M150 150 m -118 0 a 118 118 0 1 1 236 0 a 118 118 0 1 1 -236 0"></path>
      </defs>
      <circle cx="150" cy="150" r="140" fill="url(#patchFaceA)" filter="url(#patchShadowA)" style="stroke: var(--ink2); stroke-width: 6"></circle>
      <circle cx="150" cy="150" r="131" style="fill: none; stroke: var(--ink3); stroke-width: 1.4; stroke-dasharray: 3 4"></circle>
      <circle cx="150" cy="150" r="100" style="fill: none; stroke: var(--line2); stroke-width: 1.5"></circle>
      <g class="cart__spin" style="transform-origin: 150px 150px">
        <text class="cart__ring"><textPath href="#ringA">{a.ring}</textPath></text>
      </g>
      <ellipse cx="150" cy="150" rx="64" ry="22" transform="rotate(-24 150 150)" style="fill: none; stroke-width: 2.5; stroke: var(--accent)"></ellipse>
      <circle cx="150" cy="150" r="26" style="fill: var(--ink)"></circle>
      <circle cx="206" cy="124" r="8" style="fill: var(--rim)"></circle>
    </svg>
  </div>

  <div class="cart__p cart__p--b">
    <svg role="img" aria-label={b.alt} viewBox="0 0 300 300">
      <defs>
        <filter id="patchShadowB" x="-20%" y="-20%" width="140%" height="150%">
          <feDropShadow dx="0" dy="18" stdDeviation="16" style="flood-color: #000000; flood-opacity: 0.6"></feDropShadow>
        </filter>
        <radialGradient id="patchFaceB" cx="35%" cy="25%" r="80%">
          <stop offset="0" style="stop-color: var(--card2)"></stop>
          <stop offset="1" style="stop-color: var(--card)"></stop>
        </radialGradient>
        <path id="ringB" d="M150 150 m -118 0 a 118 118 0 1 1 236 0 a 118 118 0 1 1 -236 0"></path>
      </defs>
      <circle cx="150" cy="150" r="140" fill="url(#patchFaceB)" filter="url(#patchShadowB)" style="stroke-width: 6; stroke: var(--accent)"></circle>
      <circle cx="150" cy="150" r="131" style="fill: none; stroke-width: 1.4; stroke-dasharray: 3 4; stroke: var(--rim)"></circle>
      <circle cx="150" cy="150" r="100" style="fill: none; stroke: var(--line2); stroke-width: 1.5"></circle>
      <g class="cart__spin cart__spin--rev" style="transform-origin: 150px 150px">
        <text class="cart__ring"><textPath href="#ringB">{b.ring}</textPath></text>
      </g>
      <text x="150" y="176" text-anchor="middle" class="cart__word" style="font-size: 76px">{b.text}</text>
    </svg>
  </div>

  <div class="cart__p cart__p--c">
    <svg role="img" aria-label={c.alt} viewBox="0 0 300 300">
      <defs>
        <path id="ringC" d="M150 150 m -118 0 a 118 118 0 1 1 236 0 a 118 118 0 1 1 -236 0"></path>
      </defs>
      <circle cx="150" cy="150" r="140" class="cart__empty"></circle>
      <g class="cart__spin" style="transform-origin: 150px 150px">
        <text class="cart__ring cart__ring--faint"><textPath href="#ringC">{c.ring}</textPath></text>
      </g>
      <text x="150" y="182" text-anchor="middle" class="cart__word cart__word--faint" style="font-size: 100px">{c.text}</text>
    </svg>
  </div>
</div>

<style>
  .cart {
    --u: calc(100cqi / 900);
    --size: 300;
    --step: 300;
    position: relative;
    width: min(100%, 62.5cqi);
    margin-inline: auto;
    aspect-ratio: 900 / 340;
    container-type: inline-size;
  }

  .cart__p {
    position: absolute;
    width: calc(var(--size) * var(--u));
    aspect-ratio: 1;
  }

  .cart__p svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .cart__p--a {
    left: 0;
    top: calc(24 * var(--u));
    transform: rotate(-8deg);
  }
  .cart__p--b {
    left: calc(var(--step) * var(--u));
    top: 0;
  }
  .cart__p--c {
    left: calc(2 * var(--step) * var(--u));
    top: calc(32 * var(--u));
    transform: rotate(7deg);
  }

  .cart__spin {
    animation: spin 48s linear infinite;
  }
  .cart__spin--rev {
    animation-direction: reverse;
  }

  .cart__ring {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: .22em;
  }
  .cart__ring--faint {
    fill: var(--ink3);
  }

  .cart__word {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-weight: 900;
    font-stretch: 62%;
  }
  .cart__word--faint {
    fill: var(--ink3);
  }

  .cart__empty {
    fill: var(--chip-bg);
    stroke: var(--ink3);
    stroke-width: 2;
    stroke-dasharray: 6 8;
  }

  @media (max-width: 1279px) {
    .cart {
      width: min(100%, 76cqi);
    }
  }

  /* Phones: one overlapping row, the middle patch in front. */
  @media (max-width: 767px) {
    .cart {
      --size: 390;
      --step: 255;
      width: 100%;
      aspect-ratio: 900 / 450;
    }
    .cart__p--b {
      z-index: 1;
    }
  }
</style>

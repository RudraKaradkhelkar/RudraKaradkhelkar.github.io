---
// Life hero art (CHANGES.md section 4): three taped polaroids and a pencil, from
// design-handoff/reference/Drawings.html, on a 950 x 490 board. Polaroid 1 is Rudra's real
// drawing (src/assets/slots/drawing-01.jpg), cropped to the UFO, the beam, and the MIT letters;
// polaroids 2 and 3 are drawn: a poker hand with a chip stack, and a football with a draft-board
// scrawl. Each polaroid is an inline-size container.
import { Image } from 'astro:assets';
import { drawing, heroPolaroids } from '../../content/life';
import { getSlotImage } from '../../lib/slot-images';

const scan = getSlotImage(drawing.slot);
const label = heroPolaroids.map((p) => (p.kind === 'drawing' ? 'a pencil drawing' : p.caption.toLowerCase())).join('; ');
const photoBg = ['#E3E0D8', '#2F5D47', '#ECEAE3'];
---

<div class="dart" data-box="art" role="img" aria-label={`Three polaroids: ${label}`}>
  {
    heroPolaroids.map((p, i) => (
      <div class:list={['dart__pol', `dart__pol--${i}`]} aria-hidden="true" data-deal style={`--dd:${(0.4 + i * 0.1).toFixed(1)}s`}>
        <div class="dart__photo" style={`background-color:${photoBg[i]}`}>
          {p.kind === 'drawing' &&
            (scan ? (
              <Image src={scan} alt="" widths={[400, 753].filter((w) => w <= scan.width)} sizes="(min-width: 768px) 20vw, 40vw" class="dart__img dart__img--top" />
            ) : (
              <span class="dart__tag">PLACEHOLDER</span>
            ))}
          {p.kind === 'poker' && (
            <svg viewBox="0 0 268 290">
              <defs>
                <radialGradient id="feltGlow" cx="50%" cy="40%" r="70%">
                  <stop offset="0" style="stop-color: #3B7558" />
                  <stop offset="1" style="stop-color: #1F3F30" />
                </radialGradient>
              </defs>
              <rect width="268" height="290" fill="url(#feltGlow)" />
              <ellipse cx="134" cy="150" rx="118" ry="96" style="fill: none; stroke: rgba(255,255,255,.12); stroke-width: 2" />
              <g transform="rotate(-14 104 128)">
                <rect x="58" y="62" width="92" height="128" rx="10" class="lp-card" />
                <text x="72" y="92" class="lp-rank lp-rank--red">A</text>
                <path d="M104 156 C104 156 82 140 82 126 C82 116 92 111 99 116 C102 118 104 122 104 122 C104 122 106 118 109 116 C116 111 126 116 126 126 C126 140 104 156 104 156 Z" class="lp-suit" />
              </g>
              <g transform="rotate(10 160 126)">
                <rect x="114" y="58" width="92" height="128" rx="10" class="lp-card" />
                <text x="128" y="88" class="lp-rank">K</text>
                <path d="M160 108 C160 108 140 124 140 136 C140 146 150 150 157 144 L154 156 H166 L163 144 C170 150 180 146 180 136 C180 124 160 108 160 108 Z" class="lp-suit lp-suit--dark" />
              </g>
              <g class="lp-chips">
                <ellipse cx="206" cy="252" rx="30" ry="10" />
                <ellipse cx="206" cy="242" rx="30" ry="10" />
                <ellipse cx="206" cy="232" rx="30" ry="10" />
                <ellipse cx="206" cy="222" rx="30" ry="10" />
              </g>
              <g class="lp-chips lp-chips--b">
                <ellipse cx="150" cy="258" rx="26" ry="9" />
                <ellipse cx="150" cy="249" rx="26" ry="9" />
              </g>
            </svg>
          )}
          {p.kind === 'football' && (
            <svg viewBox="0 0 268 290">
              <defs>
                <filter id="penFootball" x="-5%" y="-5%" width="110%" height="110%">
                  <feTurbulence type="fractalNoise" baseFrequency="1.1" numOctaves="2" seed="5" result="n" />
                  <feDisplacementMap in="SourceGraphic" in2="n" scale="2.2" />
                </filter>
              </defs>
              <g filter="url(#penFootball)" style="fill: none; stroke: #4A4A4F; stroke-linecap: round">
                <path d="M26 40 H242 M26 82 H242 M26 124 H242 M98 40 V124 M170 40 V124" style="stroke-width: 1.4" />
                <path d="M36 62 C46 54 62 66 74 58 M110 60 C124 52 140 66 156 56 M182 62 C196 54 212 68 228 58 M36 104 C50 96 64 108 78 100 M112 102 C126 94 142 106 154 98" style="stroke-width: 1.6" />
                <path d="M190 102 L226 102 M196 96 L222 110" style="stroke-width: 1.6" />
              </g>
              <g transform="rotate(-24 134 208)">
                <ellipse cx="134" cy="208" rx="76" ry="42" class="lp-ball" />
                <path d="M74 208 C96 190 172 190 194 208" class="lp-ball-seam" />
                <path d="M104 208 H164" class="lp-lace" />
                <path d="M112 200 V216 M122 200 V216 M132 200 V216 M142 200 V216 M152 200 V216" class="lp-lace" />
              </g>
            </svg>
          )}
        </div>
        <div class="dart__cap cap">
          <span>{p.caption}</span>
          <span class="mono dart__medium">{p.tag}</span>
        </div>
        <span class="dart__tape" />
      </div>
    ))
  }
  <svg class="dart__pencil" aria-hidden="true" viewBox="0 0 440 60" data-deal style="--dd: .8s">
    <defs>
      <linearGradient id="pencilBody" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: #3A3A40" />
        <stop offset="0.45" style="stop-color: #1E1E22" />
        <stop offset="1" style="stop-color: #121214" />
      </linearGradient>
      <linearGradient id="pencilMetal" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: #F0F0F3" />
        <stop offset="0.5" style="stop-color: #9A9AA2" />
        <stop offset="1" style="stop-color: #D6D6DC" />
      </linearGradient>
      <filter id="pencilShadow" x="-10%" y="-60%" width="120%" height="260%">
        <feDropShadow dx="0" dy="10" stdDeviation="8" style="flood-color: #000000; flood-opacity: 0.6" />
      </filter>
    </defs>
    <g filter="url(#pencilShadow)">
      <rect x="30" y="17" width="300" height="26" style="fill: url(#pencilBody)" />
      <rect x="30" y="20" width="300" height="3" style="fill: rgba(255,255,255,0.12)" />
      <rect x="4" y="17" width="26" height="26" rx="4" class="dart__eraser" />
      <rect x="24" y="16" width="20" height="28" style="fill: url(#pencilMetal)" />
      <polygon points="330,17 330,43 392,30" style="fill: #D9B48A" />
      <polygon points="374,26.3 374,33.7 392,30" style="fill: #2A2A2D" />
    </g>
  </svg>
</div>

<style>
  .dart {
    --u: calc(100cqi / 950);
    --pw: 300;
    position: relative;
    width: min(100%, 66cqi);
    margin-inline: auto;
    aspect-ratio: 950 / 490;
    container-type: inline-size;
  }

  .dart__pol {
    position: absolute;
    /* One polaroid design px (the polaroid is 300 px wide in the design). */
    --pu: calc(var(--pw) / 300 * var(--u));
    width: calc(var(--pw) * var(--u));
    aspect-ratio: 300 / 380;
    padding: calc(16 * var(--pu)) calc(16 * var(--pu)) 0;
    background-color: var(--paper);
    background-image: linear-gradient(160deg, rgba(255, 255, 255, .5), rgba(0, 0, 0, .04));
    box-shadow: 0 30px 70px rgba(0, 0, 0, .55), 0 2px 6px rgba(0, 0, 0, .3);
    container-type: inline-size;
  }

  :global(:root[data-theme='light']) .dart__pol {
    box-shadow: 0 30px 70px rgba(40, 30, 20, .28), 0 2px 6px rgba(40, 30, 20, .2);
  }

  .dart__pol--0 { left: calc(20 * var(--u)); top: calc(40 * var(--u)); transform: rotate(-8deg); }
  .dart__pol--1 { left: calc(320 * var(--u)); top: calc(18 * var(--u)); transform: rotate(3deg); }
  .dart__pol--2 { left: calc(620 * var(--u)); top: calc(50 * var(--u)); transform: rotate(10deg); }

  .dart__photo {
    position: relative;
    width: 100%;
    aspect-ratio: 268 / 290;
    overflow: hidden;
  }

  .dart__photo svg,
  .dart__img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .dart__img {
    object-fit: cover;
  }

  /* The real drawing: keep the UFO, the beam, and the MIT letters in frame. */
  .dart__img--top {
    object-position: 50% 0%;
  }

  /* Inside a polaroid, container units measure its 268 px content box (300 minus padding). */
  .dart__tag {
    position: absolute;
    right: 3.73cqi;
    bottom: 2.99cqi;
    font-family: var(--font-mono);
    font-size: 3.36cqi;
    color: #55555A;
  }

  .dart__cap {
    height: 21.6cqi;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2cqi;
    font-size: 4.1cqi;
    color: #1B1B1D;
  }

  .dart__medium {
    font-size: 4.48cqi;
    color: #55555A;
  }

  .dart__tape {
    position: absolute;
    left: 33.3%;
    top: -5.22cqi;
    width: 33.3%;
    height: 10.45cqi;
    opacity: .8;
    background-color: var(--accent);
    box-shadow: 0 2px 6px rgba(0, 0, 0, .25);
  }
  .dart__pol--0 .dart__tape { transform: rotate(-4deg); }
  .dart__pol--1 .dart__tape { transform: rotate(3deg); }
  .dart__pol--2 .dart__tape { transform: rotate(-2deg); }

  .dart__pencil {
    position: absolute;
    left: calc(510 * var(--u));
    top: calc(400 * var(--u));
    width: calc(440 * var(--u));
    height: auto;
    overflow: visible;
    transform: rotate(-14deg);
  }

  .dart__eraser {
    fill: var(--accent);
  }

  /* Drawn polaroids */
  .lp-card {
    fill: #F7F5F0;
    stroke: #C9C6BE;
    stroke-width: 1.5;
  }
  .lp-rank {
    fill: #1B1B1D;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 22px;
  }
  .lp-rank--red,
  .lp-suit {
    fill: #C2362E;
  }
  .lp-suit--dark {
    fill: #1B1B1D;
  }
  .lp-chips ellipse {
    fill: var(--accent);
    stroke: #F7F5F0;
    stroke-width: 2;
    stroke-dasharray: 6 5;
  }
  .lp-chips--b ellipse {
    fill: #1B1B1D;
  }
  .lp-ball {
    fill: #7A4A2A;
    stroke: #3E2414;
    stroke-width: 2.5;
  }
  .lp-ball-seam {
    fill: none;
    stroke: #3E2414;
    stroke-width: 2;
  }
  .lp-lace {
    fill: none;
    stroke: #F7F5F0;
    stroke-width: 3;
    stroke-linecap: round;
  }

  @media (max-width: 1279px) {
    .dart {
      width: min(100%, 80cqi);
    }
  }

  /* Phones: the polaroids fan and overlap; the pencil scales with them. */
  @media (max-width: 767px) {
    .dart {
      --pw: 400;
      width: 100%;
      aspect-ratio: 950 / 700;
    }
    .dart__pol--0 { left: calc(10 * var(--u)); top: calc(60 * var(--u)); }
    .dart__pol--1 { left: calc(275 * var(--u)); top: calc(28 * var(--u)); z-index: 1; }
    .dart__pol--2 { left: calc(540 * var(--u)); top: calc(70 * var(--u)); z-index: 2; }
    .dart__pencil {
      z-index: 3;
      left: calc(330 * var(--u));
      top: calc(585 * var(--u));
      width: calc(560 * var(--u));
    }
  }
</style>
